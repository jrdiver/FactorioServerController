@page "/settings"
@using System.Security.Claims
@using FactorioLibrary.Data
@using FactorioLibrary.Models
@using FactorioLibrary.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Primitives
@inject GlobalSettingsService SettingsService
@inject AppDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<IdentityUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Global Settings</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/" class="btn btn-glass-secondary mb-3"><i class="bi bi-arrow-left me-2"></i>Back to Dashboard</a>
            <h1 class="display-6 text-accent mb-0">Global Settings</h1>
        </div>
    </div>

    <div class="row">
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <div class="col-lg-8">
                    <div class="glass-card mb-4">
                        <h4 class="mb-4"><i class="bi bi-gear-fill me-2"></i>Docker Tags Configuration</h4>
                        
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="showAllVersions" @bind="appSettings.ShowAllVersions" />
                            <label class="form-check-label text-white" for="showAllVersions">
                                <strong>Show all patch versions</strong>
                                <div class="text-muted small">By default, the dropdown only shows the latest 10 patches and the top of each minor line (e.g. 1.1.x, 1.0.x) to reduce clutter. Enable this to show every single patch ever released.</div>
                            </label>
                        </div>

                        <div class="form-check form-switch mb-4">
                            <input class="form-check-input" type="checkbox" id="showLegacyVersions" @bind="appSettings.ShowLegacyVersions" />
                            <label class="form-check-label text-white" for="showLegacyVersions">
                                <strong>Show legacy versions (pre-1.0)</strong>
                                <div class="text-muted small">Enable this to allow selecting Factorio versions released before 1.0 (e.g., 0.18, 0.17). This requires fetching additional history from Docker Hub.</div>
                            </label>
                        </div>

                        <h5 class="mt-4 mb-3 text-accent border-bottom border-secondary pb-2"><i class="bi bi-clock-history me-2"></i>Server Management</h5>
                        <div class="mb-4">
                            <label class="form-label text-muted">Graceful Shutdown Timeout (Seconds)</label>
                            <input type="number" class="form-control bg-dark text-white border-secondary" @bind="appSettings.ShutdownTimeoutSeconds" min="10" max="600" />
                            <div class="text-muted small mt-1">Maximum time to wait for a Factorio server to safely save its world and close before forcing it to stop. Highly modded servers may need more time. Default is 60.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-muted">Maximum Server Backups</label>
                            <input type="number" class="form-control bg-dark text-white border-secondary" @bind="appSettings.MaxServerBackups" min="0" max="100" />
                            <div class="text-muted small mt-1">Maximum number of backups to keep per server. When a new backup is created, the oldest backups will be deleted if this limit is exceeded. Set to 0 for unlimited. Default is 0.</div>
                        </div>

                        <h5 class="mt-4 mb-3 text-accent border-bottom border-secondary pb-2"><i class="bi bi-puzzle-fill me-2"></i>Factorio Mod Portal API</h5>
                        <p class="text-muted small mb-3">
                            These credentials are required to automatically download and update mods from the Factorio Mod Portal. You can generate a token in your factorio.com profile.
                        </p>
                        <div class="mb-3">
                            <label class="form-label text-muted">Factorio Username</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" @bind="appSettings.FactorioUsername" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label text-muted">Factorio Token</label>
                            <input type="password" class="form-control bg-dark text-white border-secondary" @bind="appSettings.FactorioToken" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            @if (showSaveSuccess)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill me-2"></i>Settings saved successfully!</span>
                            }
                            else
                            {
                                <span></span>
                            }
                            <button class="btn btn-glass" @onclick="SaveSettings"><i class="bi bi-save-fill me-2"></i>Save Settings</button>
                        </div>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
        
        <div class="@(isAdmin ? "col-lg-4" : "col-md-10 col-lg-8 col-xl-6")">
            <div class="glass-card mb-4 border border-primary border-opacity-50">
                <h4 class="mb-4 text-primary"><i class="bi bi-key-fill me-2"></i>API Access</h4>
                <p class="text-muted small mb-3">
                    Use this API Key to download server saves via direct scripts (e.g., curl or wget) by appending <code>?apikey=...</code> to the download URL.
                </p>
                
                @if (string.IsNullOrEmpty(userApiKey))
                {
                    <div class="spinner-border spinner-border-sm text-primary"></div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label text-muted">Your API Key</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-dark text-primary font-monospace border-secondary" readonly value="@userApiKey" id="apiKeyInput" />
                            <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('apiKeyInput').value)" title="Copy to clipboard">
                                <i class="bi bi-clipboard"></i>
                            </button>
                        </div>
                    </div>
                    
                    <button class="btn btn-outline-danger w-100" @onclick="RegenerateApiKey">
                        <i class="bi bi-arrow-repeat me-2"></i>Regenerate Key
                    </button>
                    @if (showKeySuccess)
                    {
                        <div class="text-success text-center mt-2 small"><i class="bi bi-check-circle-fill me-2"></i>Key regenerated!</div>
                    }
                }
            </div>

            <div class="glass-card mb-4 mt-4">
                <h4 class="mb-4 text-accent"><i class="bi bi-shield-lock-fill me-2"></i>Change Password</h4>
                
                @if (Navigation.Uri.Contains("error="))
                {
                    Uri uri = new(Navigation.Uri);
                    Dictionary<string, StringValues> query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                    if (query.TryGetValue("error", out StringValues err))
                    {
                        <div class="alert alert-danger">@err</div>
                    }
                }
                @if (Navigation.Uri.Contains("msg="))
                {
                    Uri uri = new(Navigation.Uri);
                    Dictionary<string, StringValues> query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                    if (query.TryGetValue("msg", out StringValues msg))
                    {
                        <div class="alert alert-success">@msg</div>
                    }
                }

                <form method="post" action="/api/auth/change-password">
                    <AntiforgeryToken />
                    <div class="mb-3">
                        <label class="form-label text-muted">Current Password</label>
                        <input type="password" name="currentPassword" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">New Password</label>
                        <input type="password" name="newPassword" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-muted">Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="form-control bg-dark text-white border-secondary" required />
                    </div>
                    <button type="submit" class="btn btn-glass w-100">
                        <i class="bi bi-key-fill me-2"></i>Update Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    private GlobalSettings appSettings = new();
    private bool showSaveSuccess;
    private bool showKeySuccess;
    private string? userApiKey;
    private bool isAdmin;
    private IdentityUser? currentUser;

    protected override async Task OnInitializedAsync()
    {
        appSettings = SettingsService.GetSettings();
        
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        ClaimsPrincipal user = authState.User;
        isAdmin = user.IsInRole("Administrator");
        
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUser = await UserManager.GetUserAsync(user);
            if (currentUser != null)
            {
                await LoadApiKey();
            }
        }
    }

    private async Task LoadApiKey()
    {
        if (currentUser == null) return;
        
        UserApiKey? keyRecord = await DbContext.UserApiKeys.FirstOrDefaultAsync(k => k.UserId == currentUser.Id);
        if (keyRecord != null)
        {
            userApiKey = keyRecord.ApiKey;
        }
        else
        {
            // Auto-generate if missing for some reason
            UserApiKey newKey = new()
            {
                UserId = currentUser.Id,
                ApiKey = Guid.NewGuid().ToString("N") + Guid.NewGuid().ToString("N")
            };
            DbContext.UserApiKeys.Add(newKey);
            await DbContext.SaveChangesAsync();
            userApiKey = newKey.ApiKey;
        }
    }

    private async Task RegenerateApiKey()
    {
        if (currentUser == null) return;
        
        UserApiKey? keyRecord = await DbContext.UserApiKeys.FirstOrDefaultAsync(k => k.UserId == currentUser.Id);
        if (keyRecord != null)
        {
            keyRecord.ApiKey = Guid.NewGuid().ToString("N") + Guid.NewGuid().ToString("N");
            await DbContext.SaveChangesAsync();
            userApiKey = keyRecord.ApiKey;
            
            showKeySuccess = true;
            StateHasChanged();
            
            await Task.Delay(3000);
            showKeySuccess = false;
            StateHasChanged();
        }
    }

    private async Task SaveSettings()
    {
        await SettingsService.SaveSettingsAsync(appSettings);
        
        showSaveSuccess = true;
        StateHasChanged();
        
        // Hide success message after 3 seconds
        await Task.Delay(3000);
        showSaveSuccess = false;
        StateHasChanged();
    }
}
