@page "/instance/{Id:int}/console"
@using System.Text
@using Docker.DotNet
@using FactorioLibrary.Data
@using FactorioLibrary.Models
@using FactorioLibrary.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject AppDbContext DbContext
@inject InstanceManager InstanceManager
@inject FactorioLibrary.Services.RconService RconService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<IdentityUser> UserManager

<PageTitle>Server Console - @(Instance?.Name ?? "Loading...")</PageTitle>

@if (Instance == null)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <script>
        window.setupConsoleAutoScroll = () => {
            let el = document.getElementById('console-output');
            if(!el) return;
            
            // Default to true so it snaps on first load
            let isAtBottom = true;
            
            // Track user scroll position
            el.addEventListener('scroll', () => {
                isAtBottom = el.scrollHeight - el.clientHeight <= el.scrollTop + 150;
            });
            
            // When DOM changes (new logs added), scroll if we were at the bottom
            const observer = new MutationObserver((mutations) => {
                if (isAtBottom) {
                    el.scrollTop = el.scrollHeight;
                }
            });
            
            observer.observe(el, { childList: true, subtree: true });
            
            // Initial force scroll
            el.scrollTop = el.scrollHeight;
        }
    </script>

    <div class="container-fluid py-4 d-flex flex-column" style="height: calc(100vh - 80px); max-height: calc(100vh - 80px); max-width: 100%; overflow: hidden;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1 text-white">
                    <i class="bi bi-terminal-fill me-2 text-accent"></i>
                    @Instance.Name Console
                </h2>
                <div class="text-muted">Live server logs and RCON interface</div>
            </div>
            <div class="d-flex gap-2">
                <div class="form-check form-switch mt-2 me-3">
                    <input class="form-check-input" type="checkbox" id="wordWrapToggle" @bind="WrapLogs">
                    <label class="form-check-label text-muted" for="wordWrapToggle">Word Wrap</label>
                </div>
                
                <a href="/instance/@Instance.Id" class="btn btn-glass-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to Details
                </a>
            </div>
        </div>

        <div class="glass-card flex-grow-1 d-flex flex-column overflow-hidden p-0 border border-secondary" style="min-height: 0; min-width: 0; width: 100%;">
            <div id="console-output" class="flex-grow-1 p-3" style="overflow-y: scroll; overflow-x: auto; min-height: 0; font-family: 'Consolas', 'Courier New', monospace; font-size: 0.9rem; background-color: #0f111a;">
                @if (!InstanceManager.IsRunning(Instance!.Id))
                {
                    <div class="text-danger">Server is currently offline. Start the server to view live console logs.</div>
                }
                else
                {
                    @foreach (string log in Logs)
                    {
                        <div style="white-space: @(WrapLogs ? "pre-wrap" : "pre"); word-wrap: @(WrapLogs ? "break-word" : "normal"); color: #d7d7d7;">@log</div>
                    }
                }
            </div>
            
            <div class="bg-dark p-3 border-top border-secondary">
                @if (IsViewer)
                {
                    <div class="text-muted fst-italic">You have Viewer access to this server and cannot send RCON commands.</div>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => SendPresetCommand("/time"))" disabled="@(!InstanceManager.IsRunning(Instance!.Id))">
                            <i class="bi bi-clock me-1"></i> Time
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => SendPresetCommand("/players"))" disabled="@(!InstanceManager.IsRunning(Instance!.Id))">
                            <i class="bi bi-people me-1"></i> Players
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => SendPresetCommand("/server-save"))" disabled="@(!InstanceManager.IsRunning(Instance!.Id))">
                            <i class="bi bi-save me-1"></i> Save Server
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(() => SendPresetCommand("/admins"))" disabled="@(!InstanceManager.IsRunning(Instance!.Id))">
                            <i class="bi bi-shield-lock me-1"></i> Admins
                        </button>
                    </div>
                    <form @onsubmit="SendRconCommand" class="d-flex gap-2">
                        <input type="text" @bind="RconInput" @bind:event="oninput" 
                               class="form-control bg-transparent text-white border-secondary flex-grow-1" 
                               placeholder="Enter RCON command (e.g. time, players, save)..." 
                               disabled="@(!InstanceManager.IsRunning(Instance!.Id))" />
                               
                        <button type="submit" class="btn btn-glass" disabled="@(!InstanceManager.IsRunning(Instance!.Id) || string.IsNullOrWhiteSpace(RconInput))">
                            <span><i class="bi bi-send-fill me-2"></i>Send</span>
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ServerInstance? Instance;
    private List<string> Logs = new();
    private string RconInput = "";
    private bool WrapLogs = false; // Default to no wrap as requested
    private bool IsViewer = false;
    
    private MultiplexedStream? _logStream;
    private CancellationTokenSource _cts = new();
    private bool _isConnecting = false;
    private List<string> _pendingLogs = new();
    private readonly object _logLock = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        IdentityUser? user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        bool isAdmin = await UserManager.IsInRoleAsync(user, "Administrator");
        if (!isAdmin)
        {
            UserServerAccess? access = await DbContext.UserServerAccesses.FirstOrDefaultAsync(usa => usa.UserId == user.Id && usa.ServerInstanceId == Id);
            if (access == null)
            {
                Navigation.NavigateTo("/");
                return;
            }
            IsViewer = access.AccessLevel == ServerAccessLevel.Viewer;
        }

        Instance = await DbContext.ServerInstances.FirstOrDefaultAsync(x => x.Id == Id);
        if (Instance == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (InstanceManager.IsRunning(Instance.Id))
        {
            await StartLogStreamAsync();
        }
        
        // Background task to flush pending logs to the UI exactly 10 times a second
        _ = Task.Run(async () => {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(100));
            try {
                while (await timer.WaitForNextTickAsync(_cts.Token)) {
                    bool hasLogs = false;
                    lock (_logLock) {
                        hasLogs = _pendingLogs.Count > 0;
                    }
                    
                    if (hasLogs) {
                        await InvokeAsync(() => {
                            lock (_logLock) {
                                Logs.AddRange(_pendingLogs);
                                _pendingLogs.Clear();
                            }
                            // Keep max 500 lines to prevent DOM bloat
                            if (Logs.Count > 500) {
                                Logs.RemoveRange(0, Logs.Count - 500);
                            }
                            StateHasChanged();
                        });
                        
                        // Autoscroll is now handled natively by JS MutationObserver in the browser
                    }
                    else if (_logStream == null && InstanceManager.IsRunning(Instance!.Id) && !_isConnecting)
                    {
                        _isConnecting = true;
                        // Reconnect to log stream if the server started in the background
                        _ = StartLogStreamAsync();
                        await InvokeAsync(StateHasChanged);
                    }
                }
            } catch { }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                await JSRuntime.InvokeVoidAsync("setupConsoleAutoScroll");
            }
            catch { }
        }
    }

    private async Task StartLogStreamAsync()
    {
        _logStream = await InstanceManager.GetLogStreamAsync(Instance!.Id, _cts.Token);
        _isConnecting = false;
        
        if (_logStream != null)
        {
            // Start reading logs in the background without awaiting
            _ = ReadLogsLoopAsync();
        }
    }

    private async Task ReadLogsLoopAsync()
    {
        byte[] buffer = new byte[81920];
        StringBuilder lineBuffer = new StringBuilder();
        
        try
        {
            while (!_cts.IsCancellationRequested && _logStream != null)
            {
                MultiplexedStream.ReadResult result = await _logStream.ReadOutputAsync(buffer, 0, buffer.Length, _cts.Token);
                
                if (result.EOF) break;

                if (result.Count > 0)
                {
                    string text = Encoding.UTF8.GetString(buffer, 0, result.Count);
                    
                    lineBuffer.Append(text);
                    string currentBuffer = lineBuffer.ToString();
                    
                    int newlineIndex;
                    
                    lock (_logLock) 
                    {
                        while ((newlineIndex = currentBuffer.IndexOf('\n')) >= 0)
                        {
                            string logLine = currentBuffer.Substring(0, newlineIndex).TrimEnd('\r');
                            
                            if (Instance != null)
                            {
                                if (!string.IsNullOrEmpty(Instance.RconPassword))
                                {
                                    logLine = logLine.Replace(Instance.RconPassword, "<private>");
                                }
                                if (Instance.RconPort > 0)
                                {
                                    logLine = logLine.Replace(Instance.RconPort.ToString(), "<private>");
                                }
                            }
                            
                            _pendingLogs.Add(logLine);
                            currentBuffer = currentBuffer.Substring(newlineIndex + 1);
                        }
                    }
                    
                    lineBuffer.Clear();
                    lineBuffer.Append(currentBuffer);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Expected
        }
        catch (Exception ex)
        {
            await InvokeAsync(() => {
                Logs.Add($"[Error reading logs: {ex.Message}]");
                StateHasChanged();
            });
        }
        finally
        {
            if (_logStream != null)
            {
                _logStream.Dispose();
                _logStream = null;
            }
        }
    }

    private async Task SendPresetCommand(string cmd)
    {
        RconInput = cmd;
        await SendRconCommand();
    }

    private async Task SendRconCommand()
    {
        if (string.IsNullOrWhiteSpace(RconInput) || Instance == null || !InstanceManager.IsRunning(Instance.Id))
            return;

        string command = RconInput;
        RconInput = ""; // Clear input immediately
        await InvokeAsync(StateHasChanged);
        
        try
        {
            // Connect to the Factorio RCON port via the HOST's mapped port
            // Note: Since the Controller maps the factorio container's port to the host port natively,
            // we can just connect to the host port locally. If the controller is running inside docker, 
            // the docker-compose network allows internal host access if needed, but wait: 
            // factoriotools/factorio default rcon port inside container is 27015.
            // If the controller and factorio server are on different networks, we use the host IP.
            // Wait, actually the easiest way is to connect to the Factorio container's network directly?
            // "factorio_server_{Instance.Id}" is the container name. Docker compose usually links them by container name,
            // but the Controller spins them up via the daemon, so they are placed on the default "bridge" network!
            // Wait, if the Controller is running in docker-compose, it's on a custom network.
            // A Factorio server spun up by the controller uses the default bridge network unless specified.
            // However, the Controller mapped the RconPort to the Host! So we can use host.docker.internal or 172.17.0.1 (Docker Host IP)
            // Or if we run native on windows, "127.0.0.1". 
            Logs.Add($"> {command}"); // Echo locally
            await InvokeAsync(StateHasChanged);

            string response = await RconService.SendCommandAsync(Instance.Id, Instance.RconPort, Instance.RconPassword, command);
            
            if (response.StartsWith("Error"))
            {
                Logs.Add($"[RCON Error] Could not connect to RCON port. Details: {response}");
            }
            else if (!string.IsNullOrWhiteSpace(response))
            {
                Logs.Add($"[RCON] {response.Trim()}");
            }
            else
            {
                Logs.Add($"[RCON] (Command executed successfully, no output returned)");
            }
        }
        catch (Exception ex)
        {
            Logs.Add($"[RCON Exception] {ex.Message}");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
            
            // JS MutationObserver handles scrolling now
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        if (_logStream != null)
        {
            _logStream.Dispose();
        }
        _cts.Dispose();
    }
}
