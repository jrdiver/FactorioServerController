@page "/instance/{Id:int}/mods"
@using System.IO
@using System.IO.Compression
@using System.Text.Json
@using FactorioLibrary
@using FactorioLibrary.Data
@using FactorioLibrary.Models
@using FactorioLibrary.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject InstanceManager InstanceManager
@inject ModManager ModManager
@inject NavigationManager Navigation
@inject FactorioWebApi WebApi
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<IdentityUser> UserManager
@inject IJSRuntime JS

<PageTitle>Mod Management - @(Instance?.Name ?? "Loading...")</PageTitle>

@if (Instance == null)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <NavigationLock ConfirmExternalNavigation="IsUploading" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

    <div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="/instance/@Instance.Id" class="btn btn-glass-secondary mb-3"><i class="bi bi-arrow-left me-2"></i>Back to Settings</a>
                <h1 class="display-6 text-white mb-0">
                    <i class="bi bi-puzzle me-2 text-accent"></i>
                    Mod Management
                </h1>
                <div class="text-muted">Upload and toggle mods for @Instance.Name</div>
            </div>
        </div>

        <div class="glass-card mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Installed Mods</h4>
                <div>
                    @if (!IsViewer)
                    {
                        <button class="btn btn-glass-secondary me-3" @onclick="CheckForUpdates" disabled="@IsCheckingUpdates">
                            @if (IsCheckingUpdates)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Checking...</span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-repeat me-2"></i><span>Check for Updates</span>
                            }
                        </button>
                        <button class="btn btn-glass-secondary me-3" @onclick="SyncWithSave" disabled="@IsSyncing">
                            @if (IsSyncing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>Syncing...</span>
                            }
                            else
                            {
                                <i class="bi bi-arrow-repeat me-2"></i><span>Sync from Save</span>
                            }
                        </button>
                        <div class="dropdown d-inline-block me-3">
                            <button class="btn btn-glass-secondary dropdown-toggle" type="button" @onclick="() => _showModpackDropdown = !_showModpackDropdown" @onfocusout="() => Task.Delay(200).ContinueWith(_ => { _showModpackDropdown = false; InvokeAsync(StateHasChanged); })" aria-expanded="@(_showModpackDropdown ? "true" : "false")" disabled="@IsApplyingModpack">
                                @if (IsApplyingModpack)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Applying... @(!string.IsNullOrEmpty(UpdateProgressFraction) ? $"({UpdateProgressFraction})" : "")</span>
                                }
                                else
                                {
                                    <i class="bi bi-box2 me-2"></i><span>Apply Modpack</span>
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark shadow @(_showModpackDropdown ? "show" : "")" style="@(_showModpackDropdown ? "display: block; position: absolute; inset: 0px auto auto 0px; margin: 0px; transform: translate3d(0px, 40px, 0px);" : "")">
                                @if (AvailableModpacks == null || !AvailableModpacks.Any())
                                {
                                    <li><span class="dropdown-item text-muted">No Modpacks Available</span></li>
                                }
                                else
                                {
                                    @foreach (var modpack in AvailableModpacks)
                                    {
                                        <li><button class="dropdown-item" type="button" @onclick="() => { _showModpackDropdown = false; ApplyModpack(modpack); }">@modpack.Name</button></li>
                                    }
                                }
                            </ul>
                        </div>
                        <button class="btn btn-glass-secondary me-3" @onclick="SaveAsModpack" disabled="@IsSavingModpack">
                            @if (IsSavingModpack)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span><span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-floppy me-2"></i><span>Save as Modpack</span>
                            }
                        </button>
                        @if (ModFiles?.Any(m => m.HasUpdateAvailable && !m.IsIgnored) == true)
                        {
                            <button class="btn btn-glass me-3" @onclick="UpdateAllMods" disabled="@IsUpdating">
                                @if (IsUpdating)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Updating... @(!string.IsNullOrEmpty(UpdateProgressFraction) ? $"({UpdateProgressFraction})" : "")</span>
                                }
                                else
                                {
                                    <i class="bi bi-cloud-download me-2"></i><span>Update All</span>
                                }
                            </button>
                        }

                        <InputFile OnChange="UploadModFiles" class="d-none" id="modUpload" accept=".zip,.json,.dat" multiple />
                        <button class="btn btn-glass me-3" type="button" onclick="document.getElementById('modUpload').click()" disabled="@IsUploading">
                            @if (IsUploading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Uploading... (@UploadProgress)</span>
                            }
                            else
                            {
                                <i class="bi bi-upload me-2"></i><span>Upload Mods</span>
                            }
                        </button>
                    }
                    <a href="/api/instances/@Instance.Id/mods/downloadAll" class="btn btn-glass-secondary me-3" download>
                        <i class="bi bi-cloud-arrow-down me-2"></i><span>Download Mod Pack</span>
                    </a>
                    @if (!IsViewer)
                    {
                        <button class="btn btn-danger" @onclick="DeleteAllModsWithConfirm" disabled="@(IsUpdating || IsUploading)">
                            <i class="bi bi-trash me-2"></i><span>Delete All</span>
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(UploadError))
            {
                <div class="alert alert-danger">@UploadError</div>
            }
            @if (!string.IsNullOrEmpty(SyncError))
            {
                <div class="alert alert-danger text-pre-wrap"><i class="bi bi-exclamation-triangle me-2"></i>@SyncError</div>
            }
            @if (!string.IsNullOrEmpty(SuccessMessage))
            {
                <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@SuccessMessage</div>
            }
            @if (!string.IsNullOrEmpty(UpdateError))
            {
                <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@UpdateError</div>
            }
            @if (!string.IsNullOrEmpty(UpdateProgress))
            {
                <div class="alert alert-info d-flex align-items-center">
                    <span class="spinner-border spinner-border-sm me-3"></span>
                    <span>@UpdateProgress</span>
                </div>
            }

            @if (ModFiles == null)
            {
                <div class="text-center text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Loading mods...</div>
            }
            else if (!ModFiles.Any())
            {
                <div class="text-center text-muted my-4">
                    <i class="bi bi-puzzle display-4 mb-3 d-block text-secondary"></i>
                    No mods installed for this instance.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-borderless align-middle mb-0">
                        <thead class="border-bottom border-secondary">
                            <tr>
                                <th style="width: 50px;">Status</th>
                                <th>Mod File</th>
                                <th class="text-end">Size</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mod in ModFiles)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!mod.IsConfig)
                                            {
                                                <div class="form-check form-switch fs-5 mb-0 me-2">
                                                    <input class="form-check-input @(mod.IsEnabled ? "bg-success border-success" : "bg-danger border-danger")" type="checkbox" checked="@mod.IsEnabled" @onchange="@(e => ToggleMod(mod, (bool)(e.Value ?? false)))" disabled="@IsViewer">
                                                </div>
                                                @if (!mod.IsBuiltIn && !IsViewer)
                                                {
                                                    <button class="btn btn-sm btn-link p-0 text-@(mod.IsIgnored ? "warning" : "secondary")" @onclick="() => TogglePin(mod)" title="@(mod.IsIgnored ? "Unpin Mod" : "Pin Mod (Prevent Updates)")">
                                                        <i class="bi @(mod.IsIgnored ? "bi-pin-angle-fill" : "bi-pin-angle") fs-5"></i>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (mod.IsConfig)
                                        {
                                            <i class="bi bi-file-earmark-code text-secondary me-2"></i>
                                            <span class="text-white fw-bold">@mod.Name</span>
                                            <span class="badge bg-secondary ms-2">Configuration</span>
                                        }
                                        else if (mod.IsBuiltIn)
                                        {
                                            <i class="bi bi-box-seam text-accent me-2"></i>
                                            <span class="text-white @(mod.IsEnabled ? "" : "text-muted")">@mod.ModName <span class="badge bg-secondary ms-2">Built-in</span></span>
                                        }
                                        else if (mod.IsMissing)
                                        {
                                            <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                                            <a href="https://mods.factorio.com/mod/@Uri.EscapeDataString(mod.ModName)" target="_blank" class="text-danger text-decoration-none fw-bold @(mod.IsEnabled ? "" : "text-muted")">@mod.ModName</a>
                                            <span class="badge bg-danger ms-2">Missing</span>
                                            
                                            @if (mod.IsDeprecated)
                                            {
                                                <span class="badge bg-danger ms-2" title="This mod is marked as deprecated on the mod portal">Deprecated</span>
                                            }
                                            @if (mod.HasUpdateAvailable && !mod.IsIgnored)
                                            {
                                                <span class="badge bg-primary ms-2" title="Latest: @mod.LatestVersion">Download Available</span>
                                            }
                                        }
                                        else
                                        {
                                            <i class="bi bi-file-zip text-accent me-2"></i>
                                            <a href="https://mods.factorio.com/mod/@Uri.EscapeDataString(mod.ModName)" target="_blank" class="text-white text-decoration-none fw-bold @(mod.IsEnabled ? "" : "text-muted") @(mod.IsIgnored ? "text-warning" : "")">@mod.Name</a>
                                            
                                            @if (mod.IsDeprecated)
                                            {
                                                <span class="badge bg-danger ms-2" title="This mod is marked as deprecated on the mod portal">Deprecated</span>
                                            }
                                            @if (mod.HasUpdateAvailable && !mod.IsIgnored)
                                            {
                                                <span class="badge bg-primary ms-2" title="Latest: @mod.LatestVersion">Update Available</span>
                                            }
                                            else if (mod.IsIgnored)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">Pinned</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-muted text-end">@(mod.IsBuiltIn || mod.IsMissing ? "-" : FormatBytes(mod.SizeBytes))</td>
                                    <td class="text-end">
                                        @if (!mod.IsBuiltIn)
                                        {
                                            @if (mod.HasUpdateAvailable && !mod.IsIgnored && !IsViewer)
                                            {
                                                <button class="btn btn-sm btn-primary me-2" @onclick="() => UpdateMod(mod)" disabled="@IsUpdating" title="@(mod.IsMissing ? "Download" : "Update") to @mod.LatestVersion">
                                                    <i class="bi bi-cloud-download"></i>
                                                </button>
                                            }
                                            @if (!mod.IsMissing)
                                            {
                                                <a href="/api/instances/@Instance.Id/mods/@mod.Name" class="btn btn-sm btn-glass-secondary text-primary me-2" download title="Download Mod">
                                                    <i class="bi bi-cloud-arrow-down"></i>
                                                </a>
                                            }
                                            @if (!IsViewer && !mod.IsConfig)
                                            {
                                                <button class="btn btn-sm btn-glass-secondary text-danger" @onclick="() => DeleteModWithConfirm(mod)" title="Delete Mod">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small mt-3">
                    <i class="bi bi-info-circle me-1"></i> Changes to mods require a server restart to take effect.
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ServerInstance? Instance;
    private List<ModFileInfo>? ModFiles;
    private bool IsUploading = false;
    private bool IsSyncing = false;
    
    private string UploadProgress = "";
    private string? UploadError;
    private string? SyncError;
    private ModList _modList = new ModList();
    
    private List<FactorioLibrary.Models.Modpack>? AvailableModpacks;
    private bool IsApplyingModpack = false;
    private bool IsSavingModpack = false;
    private bool _showModpackDropdown = false;

    private class ModFileInfo
    {
        public string Name { get; set; } = "";
        public string ModName { get; set; } = "";
        public string CurrentVersion { get; set; } = "";
        public string LatestVersion { get; set; } = "";
        public string DownloadUrl { get; set; } = "";
        public string NewFileName { get; set; } = "";
        public bool HasUpdateAvailable { get; set; }
        public long SizeBytes { get; set; }
        public bool IsEnabled { get; set; }
        public bool IsBuiltIn { get; set; }
        public bool IsIgnored { get; set; }
        public bool IsMissing { get; set; }
        public bool IsDeprecated { get; set; }
        public bool IsConfig { get; set; }
    }

    private static readonly HashSet<string> BuiltInMods = new(StringComparer.OrdinalIgnoreCase) 
    { 
        "base", "core", "elevated-rails", "quality", "space-age" 
    };

    private bool IsCheckingUpdates = false;
    private bool IsUpdating = false;
    private string? UpdateError;
    private string? SuccessMessage;
    private string? UpdateProgress;
    private string? UpdateProgressFraction;
    private bool IsViewer = false;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        IdentityUser? user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        bool isAdmin = await UserManager.IsInRoleAsync(user, "Administrator");
        if (!isAdmin)
        {
            UserServerAccess? access = await DbContext.UserServerAccesses.FirstOrDefaultAsync(usa => usa.UserId == user.Id && usa.ServerInstanceId == Id);
            if (access == null)
            {
                Navigation.NavigateTo("/");
                return;
            }
            IsViewer = access.AccessLevel == ServerAccessLevel.Viewer;
        }

        Instance = await DbContext.ServerInstances.FirstOrDefaultAsync(x => x.Id == Id);
        if (Instance == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        AvailableModpacks = await DbContext.Modpacks.ToListAsync();

        LoadMods();
        await UpdateModCacheData();
    }

    private void LoadMods()
    {
        try
        {
            string modsDir = InstanceManager.GetModsDirectory(Id);
            if (!Directory.Exists(modsDir))
            {
                Directory.CreateDirectory(modsDir);
            }

            string modListPath = Path.Combine(modsDir, "mod-list.json");
            if (File.Exists(modListPath))
            {
                try
                {
                    string json = File.ReadAllText(modListPath);
                    _modList = JsonSerializer.Deserialize<ModList>(json) ?? new ModList();
                }
                catch
                {
                    _modList = new ModList();
                }
            }

            DirectoryInfo dirInfo = new DirectoryInfo(modsDir);
            ModFiles = dirInfo.GetFiles("*.zip")
                .Select(f => new ModFileInfo
                {
                    Name = f.Name,
                    ModName = GetModNameFromFilename(f.Name),
                    CurrentVersion = GetModVersionFromFilename(f.Name),
                    SizeBytes = f.Length,
                    IsEnabled = _modList.Mods.FirstOrDefault(m => string.Equals(m.Name, GetModNameFromFilename(f.Name), StringComparison.OrdinalIgnoreCase))?.Enabled ?? false,
                    IsBuiltIn = false,
                    IsIgnored = Instance?.IgnoredMods.Contains(GetModNameFromFilename(f.Name)) ?? false
                })
                .ToList();

            var configFiles = dirInfo.GetFiles().Where(f => f.Name.Equals("mod-list.json", StringComparison.OrdinalIgnoreCase) || f.Name.Equals("mod-settings.dat", StringComparison.OrdinalIgnoreCase));
            foreach (var cfg in configFiles)
            {
                ModFiles.Add(new ModFileInfo
                {
                    Name = cfg.Name,
                    ModName = cfg.Name,
                    SizeBytes = cfg.Length,
                    IsEnabled = true,
                    IsBuiltIn = false,
                    IsConfig = true
                });
            }

            foreach (var mod in _modList.Mods)
            {
                if (!ModFiles.Any(m => m.ModName.Equals(mod.Name, StringComparison.OrdinalIgnoreCase)))
                {
                    bool isBuiltIn = BuiltInMods.Contains(mod.Name);
                    ModFiles.Add(new ModFileInfo
                    {
                        Name = isBuiltIn ? "(Built-in Factorio Expansion)" : "(Missing Mod File)",
                        ModName = mod.Name,
                        SizeBytes = 0,
                        IsEnabled = mod.Enabled,
                        IsBuiltIn = isBuiltIn,
                        IsMissing = !isBuiltIn
                    });
                }
            }

            ModFiles = ModFiles.OrderByDescending(m => m.IsConfig).ThenBy(m => m.ModName).ToList();
        }
        catch (Exception)
        {
            ModFiles = new List<ModFileInfo>();
        }
    }

    private string GetModNameFromFilename(string filename)
    {
        if (string.IsNullOrEmpty(filename) || !filename.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            return filename;

        // Factorio mod filenames are usually "ModName_1.0.0.zip"
        string nameWithoutExt = filename.Substring(0, filename.Length - 4);
        int lastUnderscore = nameWithoutExt.LastIndexOf('_');
        
        if (lastUnderscore > 0)
        {
            return nameWithoutExt.Substring(0, lastUnderscore);
        }
        
        return nameWithoutExt;
    }

    private string GetModVersionFromFilename(string filename)
    {
        if (string.IsNullOrEmpty(filename) || !filename.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
            return "";

        string nameWithoutExt = filename.Substring(0, filename.Length - 4);
        int lastUnderscore = nameWithoutExt.LastIndexOf('_');
        
        if (lastUnderscore > 0 && lastUnderscore < nameWithoutExt.Length - 1)
        {
            return nameWithoutExt.Substring(lastUnderscore + 1);
        }
        
        return "";
    }

    private async Task UpdateModCacheData()
    {
        if (ModFiles == null || !ModFiles.Any()) return;
        
        string targetFactorioVersion = "";
        if (Instance != null && !string.IsNullOrEmpty(Instance.AssignedVersion) && Instance.AssignedVersion != "latest")
        {
            string[] parts = Instance.AssignedVersion.Split('.');
            if (parts.Length >= 2)
            {
                targetFactorioVersion = $"{parts[0]}.{parts[1]}";
            }
        }
        
        var checkableMods = ModFiles.Where(m => !m.IsBuiltIn && !m.IsConfig && !(string.IsNullOrEmpty(m.CurrentVersion) && !m.IsMissing)).ToList();
        int total = checkableMods.Count;
        int current = 0;
        
        foreach (var mod in ModFiles)
        {
            if (mod.IsBuiltIn || mod.IsConfig || (string.IsNullOrEmpty(mod.CurrentVersion) && !mod.IsMissing)) continue;
            
            current++;
            if (IsApplyingModpack || IsSyncing)
            {
                UpdateProgressFraction = $"{current}/{total}";
                UpdateProgress = $"Checking mod portal ({UpdateProgressFraction}) {mod.ModName}...";
                StateHasChanged();
            }
            
            var info = await ModManager.GetCachedModInfoAsync(mod.ModName, forceRefresh: false);
            ApplyModUpdateData(mod, info, targetFactorioVersion);
            
            // Yield to prevent blocking the UI thread on large modpacks
            if (current % 5 == 0)
            {
                await Task.Delay(1);
            }
        }
    }

    private void ApplyModUpdateData(ModFileInfo mod, FactorioLibrary.Services.ModInfo? info, string targetFactorioVersion)
    {
        if (info == null) return;
        
        mod.IsDeprecated = info.Deprecated;
        
        if (info.Releases != null && info.Releases.Any())
        {
            List<FactorioLibrary.Services.ModRelease> validReleases = info.Releases;
            if (!string.IsNullOrEmpty(targetFactorioVersion))
            {
                var filtered = validReleases.Where(r => r.InfoJson != null && r.InfoJson.FactorioVersion == targetFactorioVersion).ToList();
                if (!filtered.Any() && targetFactorioVersion == "2.1")
                {
                    filtered = validReleases.Where(r => r.InfoJson != null && r.InfoJson.FactorioVersion == "2.0").ToList();
                }
                if (filtered.Any()) validReleases = filtered;
            }
            
            var latestRelease = validReleases.LastOrDefault();
            if (latestRelease != null && !string.IsNullOrEmpty(latestRelease.Version))
            {
                mod.LatestVersion = latestRelease.Version;
                mod.DownloadUrl = latestRelease.DownloadUrl;
                mod.NewFileName = latestRelease.FileName;
                
                if (mod.IsMissing)
                {
                    mod.HasUpdateAvailable = true;
                }
                else if (Version.TryParse(mod.CurrentVersion, out Version? currentVer) && 
                         Version.TryParse(latestRelease.Version, out Version? latestVer))
                {
                    mod.HasUpdateAvailable = latestVer > currentVer;
                }
                else
                {
                    mod.HasUpdateAvailable = mod.CurrentVersion != latestRelease.Version;
                }
            }
        }
    }

    private async Task CheckForUpdates()
    {
        if (ModFiles == null || !ModFiles.Any()) return;
        
        IsCheckingUpdates = true;
        StateHasChanged();
        
        string targetFactorioVersion = "";
        if (Instance != null && !string.IsNullOrEmpty(Instance.AssignedVersion) && Instance.AssignedVersion != "latest")
        {
            string[] parts = Instance.AssignedVersion.Split('.');
            if (parts.Length >= 2)
            {
                targetFactorioVersion = $"{parts[0]}.{parts[1]}"; // e.g. "1.1" or "2.1"
            }
        }
        
        try
        {
            foreach (var mod in ModFiles)
            {
                if (mod.IsBuiltIn || (string.IsNullOrEmpty(mod.CurrentVersion) && !mod.IsMissing)) continue;
                
                var info = await ModManager.GetCachedModInfoAsync(mod.ModName, forceRefresh: true);
                ApplyModUpdateData(mod, info, targetFactorioVersion);
            }
        }
        finally
        {
            IsCheckingUpdates = false;
            StateHasChanged();
        }
    }

    private void SaveModListJson()
    {
        string modsDir = InstanceManager.GetModsDirectory(Id);
        string modListPath = Path.Combine(modsDir, "mod-list.json");
        
        JsonSerializerOptions options = new JsonSerializerOptions { WriteIndented = true };
        string json = JsonSerializer.Serialize(_modList, options);
        File.WriteAllText(modListPath, json);
    }

    private async Task TogglePin(ModFileInfo mod)
    {
        if (Instance == null) return;
        
        mod.IsIgnored = !mod.IsIgnored;
        
        if (mod.IsIgnored && !Instance.IgnoredMods.Contains(mod.ModName))
        {
            Instance.IgnoredMods.Add(mod.ModName);
        }
        else if (!mod.IsIgnored)
        {
            Instance.IgnoredMods.Remove(mod.ModName);
        }
        
        DbContext.ServerInstances.Update(Instance);
        await DbContext.SaveChangesAsync();
        StateHasChanged();
    }

    private void ToggleMod(ModFileInfo mod, bool enabled)
    {
        mod.IsEnabled = enabled;
        
        var entry = _modList.Mods.FirstOrDefault(m => string.Equals(m.Name, mod.ModName, StringComparison.OrdinalIgnoreCase));
        if (entry != null)
        {
            entry.Enabled = enabled;
        }
        else
        {
            _modList.Mods.Add(new ModEntry { Name = mod.ModName, Enabled = enabled });
        }
        
        SaveModListJson();
    }

    private async Task UpdateMod(ModFileInfo mod)
    {
        if (Instance == null || string.IsNullOrEmpty(mod.DownloadUrl)) return;
        
        IsUpdating = true;
        UpdateError = null;
        SuccessMessage = null;
        StateHasChanged();
        
        var result = await ModManager.UpdateModAsync(Id, mod.ModName, mod.DownloadUrl, mod.NewFileName, mod.Name);
        if (result.success)
        {
            SuccessMessage = $"Successfully updated {mod.ModName} to {mod.LatestVersion}";
            LoadMods();
        }
        else
        {
            UpdateError = $"Failed to update {mod.ModName}: {result.error}";
        }
        
        IsUpdating = false;
        StateHasChanged();
    }

    private async Task UpdateAllMods()
    {
        if (Instance == null || ModFiles == null) return;
        
        var updatable = ModFiles.Where(m => m.HasUpdateAvailable && !m.IsIgnored && !m.IsBuiltIn).ToList();
        if (!updatable.Any()) return;
        
        IsUpdating = true;
        UpdateError = null;
        if (!IsApplyingModpack && !IsSyncing)
        {
            SuccessMessage = null;
        }
        UpdateProgress = $"Starting update of {updatable.Count} mods...";
        StateHasChanged();
        
        int successCount = 0;
        foreach (var mod in updatable)
        {
            if (string.IsNullOrEmpty(mod.DownloadUrl)) continue;
            
            UpdateProgressFraction = $"{successCount + 1}/{updatable.Count}";
            UpdateProgress = $"Updating ({UpdateProgressFraction}) {mod.ModName}...";
            StateHasChanged();
            await Task.Delay(1);
            
            var result = await ModManager.UpdateModAsync(Id, mod.ModName, mod.DownloadUrl, mod.NewFileName, mod.Name);
            if (result.success) successCount++;
            else
            {
                UpdateError = $"Failed on {mod.ModName}: {result.error}";
                break; // stop on first error
            }
        }
        
        if (successCount > 0)
        {
            if (IsApplyingModpack)
            {
                SuccessMessage = $"Successfully applied modpack! Additionally, downloaded {successCount} mod updates from the Factorio Portal.";
            }
            else if (IsSyncing)
            {
                SuccessMessage = $"Successfully synced save! Additionally, downloaded {successCount} mod updates from the Factorio Portal.";
            }
            else
            {
                SuccessMessage = $"Successfully updated {successCount} mods!";
            }
            LoadMods();
        }
        
        UpdateProgress = null;
        UpdateProgressFraction = null;
        IsUpdating = false;
        StateHasChanged();
    }

    private async Task OnBeforeInternalNavigation(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (IsUploading)
        {
            bool isConfirmed = await JS.InvokeAsync<bool>("confirm", "A mod upload is currently in progress. If you leave this page, the upload will be cancelled. Are you sure you want to leave?");
            if (!isConfirmed)
            {
                context.PreventNavigation();
            }
        }
    }

    private async Task UploadModFiles(InputFileChangeEventArgs e)
    {
        IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile> files = e.GetMultipleFiles(500); // Allow up to 500 files at once
        if (!files.Any()) return;

        IsUploading = true;
        UploadError = null;
        int completed = 0;
        int total = files.Count;

        try
        {
            string modsDir = InstanceManager.GetModsDirectory(Id);
            if (!Directory.Exists(modsDir)) Directory.CreateDirectory(modsDir);

            foreach (Microsoft.AspNetCore.Components.Forms.IBrowserFile file in files)
            {
                if (file.Name.Equals("mod-list.json", StringComparison.OrdinalIgnoreCase))
                {
                    string modListPath = Path.Combine(modsDir, "mod-list.json");
                    await using Stream jsonStream = file.OpenReadStream(2147483648);
                    await using FileStream jsonFs = new FileStream(modListPath, FileMode.Create, FileAccess.Write, FileShare.None, 81920, true);
                    await jsonStream.CopyToAsync(jsonFs);
                    continue;
                }
                
                if (file.Name.Equals("mod-settings.dat", StringComparison.OrdinalIgnoreCase))
                {
                    string modSettingsPath = Path.Combine(modsDir, "mod-settings.dat");
                    await using Stream datStream = file.OpenReadStream(2147483648);
                    await using FileStream datFs = new FileStream(modSettingsPath, FileMode.Create, FileAccess.Write, FileShare.None, 81920, true);
                    await datStream.CopyToAsync(datFs);
                    continue;
                }

                if (!file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
                {
                    continue; // Skip non-zip files
                }

                UploadProgress = $"{completed}/{total}";
                StateHasChanged();

                string path = Path.Combine(modsDir, file.Name);

                // Allow up to 2GB max file size
                await using Stream stream = file.OpenReadStream(2147483648);
                await using FileStream fs = new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.None, 81920, true);
                await stream.CopyToAsync(fs);
                fs.Close();

                ModManager.CopyToGlobalPool(path);

                completed++;
                
                // Add to mod-list.json automatically
                string modName = GetModNameFromFilename(file.Name);
                if (!_modList.Mods.Any(m => string.Equals(m.Name, modName, StringComparison.OrdinalIgnoreCase)))
                {
                    _modList.Mods.Add(new ModEntry { Name = modName, Enabled = true });
                }
            }

            SaveModListJson();
            LoadMods();
        }
        catch (Exception ex)
        {
            UploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    private async Task SyncWithSave()
    {
        if (Instance == null) return;
        
        IsSyncing = true;
        SyncError = null;
        SuccessMessage = null;
        StateHasChanged();

        try
        {
            string targetSave = Instance.ActiveSaveName ?? "";
            
            if (string.IsNullOrEmpty(targetSave))
            {
                string savesDir = InstanceManager.GetSavesDirectory(Id);
                if (Directory.Exists(savesDir))
                {
                    DirectoryInfo dirInfo = new DirectoryInfo(savesDir);
                    FileInfo? latest = dirInfo.GetFiles("*.zip").OrderByDescending(f => f.LastWriteTimeUtc).FirstOrDefault();
                    if (latest != null)
                    {
                        targetSave = latest.Name;
                    }
                }
            }

            if (string.IsNullOrEmpty(targetSave))
            {
                SyncError = "No save files found on the server to sync with.";
                return;
            }

            string imageTag = string.IsNullOrWhiteSpace(Instance.AssignedVersion) ? "latest" : Instance.AssignedVersion;
            var result = await InstanceManager.SyncModsWithSaveAsync(Id, targetSave, imageTag);

            if (result.Success)
            {
                // Also manually extract mod-settings.dat since Factorio's native command doesn't do it
                ExtractModSettingsFromSave(targetSave);
                
                SuccessMessage = "Successfully synced mod configuration with the active save file!";
                LoadMods(); // Reload the updated mod-list.json
            }
            else
            {
                SyncError = $"Sync failed. Is the save file from a different Factorio version?\n\nLog Output:\n{result.Logs}";
            }
        }
        catch (Exception ex)
        {
            SyncError = $"Error executing sync: {ex.Message}";
        }
        finally
        {
            IsSyncing = false;
            StateHasChanged();
        }
    }

    private async Task DeleteModWithConfirm(ModFileInfo mod)
    {
        if (Instance == null) return;
        
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to delete {mod.ModName}?");
        if (confirmed)
        {
            if (!mod.IsMissing && !string.IsNullOrEmpty(mod.Name))
            {
                string modsDir = InstanceManager.GetModsDirectory(Id);
                string path = Path.Combine(modsDir, mod.Name);
                if (File.Exists(path))
                {
                    File.Delete(path);
                }
            }

            // Remove from mod-list.json
            var entry = _modList.Mods.FirstOrDefault(m => string.Equals(m.Name, mod.ModName, StringComparison.OrdinalIgnoreCase));
            if (entry != null)
            {
                _modList.Mods.Remove(entry);
                SaveModListJson();
            }

            LoadMods();
        }
    }

    private async Task DeleteAllModsWithConfirm()
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete ALL mods and mod settings? This cannot be undone.");
        if (confirmed)
        {
            DeleteAllMods();
        }
    }

    private void DeleteAllMods()
    {
        try
        {
            string modsDir = InstanceManager.GetModsDirectory(Id);
            if (Directory.Exists(modsDir))
            {
                DirectoryInfo dirInfo = new DirectoryInfo(modsDir);
                foreach (FileInfo file in dirInfo.GetFiles("*.zip"))
                {
                    file.Delete();
                }

                // Delete mod-settings.dat as requested by user
                string settingsPath = Path.Combine(modsDir, "mod-settings.dat");
                if (File.Exists(settingsPath))
                {
                    File.Delete(settingsPath);
                }

                // Clear the internal list so it saves an empty json
                _modList.Mods.Clear();
                SaveModListJson();
                LoadMods();
                
                SuccessMessage = "Successfully deleted all mods and settings!";
                UpdateError = null;
            }
        }
        catch (Exception ex)
        {
            UpdateError = $"Error deleting mods: {ex.Message}";
            SuccessMessage = null;
        }
    }

    private void ExtractModSettingsFromSave(string saveName)
    {
        try
        {
            string savePath = Path.Combine(InstanceManager.GetSavesDirectory(Id), saveName);
            using System.IO.Compression.ZipArchive archive = System.IO.Compression.ZipFile.OpenRead(savePath);
            System.IO.Compression.ZipArchiveEntry? entry = archive.Entries.FirstOrDefault(e => e.Name.Equals("mod-settings.dat", StringComparison.OrdinalIgnoreCase));
            
            if (entry != null)
            {
                string destPath = Path.Combine(InstanceManager.GetModsDirectory(Id), "mod-settings.dat");
                entry.ExtractToFile(destPath, true);
            }
        }
        catch
        {
            // Ignore if the save doesn't have it or extraction fails
        }
    }

    private string FormatBytes(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB", "TB" };
        int counter = 0;
        decimal number = (decimal)bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number = number / 1024;
            counter++;
        }
        return string.Format("{0:n1} {1}", number, suffixes[counter]);
    }

    private async Task ApplyModpack(FactorioLibrary.Models.Modpack modpack)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", $"Are you sure you want to apply the '{modpack.Name}' modpack? This will overwrite your current mod-list.json and mod-settings.dat, and you will need to download missing mods.");
        if (!confirmed) return;

        IsApplyingModpack = true;
        SyncError = null;
        SuccessMessage = null;
        UpdateProgress = "Applying mod configuration...";
        StateHasChanged();

        try
        {
            string modsDir = InstanceManager.GetModsDirectory(Id);
            if (!Directory.Exists(modsDir)) Directory.CreateDirectory(modsDir);

            string modListPath = Path.Combine(modsDir, "mod-list.json");
            await File.WriteAllTextAsync(modListPath, modpack.ModListJson);

            if (modpack.ModSettingsDat != null && modpack.ModSettingsDat.Length > 0)
            {
                string modSettingsPath = Path.Combine(modsDir, "mod-settings.dat");
                await File.WriteAllBytesAsync(modSettingsPath, modpack.ModSettingsDat);
            }

            SuccessMessage = "Successfully applied modpack!";
            
            if (Instance != null && !string.IsNullOrEmpty(modpack.TargetFactorioVersion))
            {
                string targetVersion = modpack.TargetFactorioVersion;
                if (targetVersion != "latest" && targetVersion != "stable" && targetVersion.Count(c => c == '.') < 2)
                {
                    // Convert "2" or "2.0" to the highest specific patch "2.0.x" available
                    try
                    {
                        var tags = await WebApi.GetDockerTagsAsync();
                        var matchingTag = tags.FirstOrDefault(t => t.Tag.StartsWith($"{targetVersion}."));
                        if (matchingTag != null)
                        {
                            targetVersion = matchingTag.Tag;
                        }
                    }
                    catch { } // fallback to original if API fails
                }

                if (Instance.AssignedVersion != targetVersion)
                {
                    Instance.AssignedVersion = targetVersion;
                    DbContext.ServerInstances.Update(Instance);
                    await DbContext.SaveChangesAsync();
                }
            }
            
            // Check global mods first!
            await InstanceManager.ResolveMissingModsFromGlobalAsync(Id, (current, total, zipName) => 
            {
                UpdateProgressFraction = $"{current}/{total}";
                UpdateProgress = $"Copying local cache ({UpdateProgressFraction}) {zipName}...";
                InvokeAsync(StateHasChanged);
            });
            
            // Reload mods and check updates
            LoadMods();
            await UpdateModCacheData();
            
            // Auto-trigger an update for all missing mods (so it acts like a true modpack sync)
            if (ModFiles != null && ModFiles.Any(m => m.IsMissing || m.HasUpdateAvailable))
            {
                await UpdateAllMods();
            }
        }
        catch (Exception ex)
        {
            SyncError = $"Failed to apply modpack: {ex.Message}";
        }
        finally
        {
            UpdateProgress = null;
            IsApplyingModpack = false;
            StateHasChanged();
        }
    }

    private async Task SaveAsModpack()
    {
        string modpackName = await JS.InvokeAsync<string>("prompt", "Enter a name for this new Modpack:");
        if (string.IsNullOrWhiteSpace(modpackName)) return;

        IsSavingModpack = true;
        SyncError = null;
        SuccessMessage = null;
        StateHasChanged();

        try
        {
            string modsDir = InstanceManager.GetModsDirectory(Id);
            string modListPath = Path.Combine(modsDir, "mod-list.json");
            string modSettingsPath = Path.Combine(modsDir, "mod-settings.dat");

            string jsonContent = "";
            byte[]? datContent = null;

            if (File.Exists(modListPath))
            {
                jsonContent = await File.ReadAllTextAsync(modListPath);
            }
            else
            {
                throw new Exception("mod-list.json not found. Ensure the server has been run at least once to generate it.");
            }

            if (File.Exists(modSettingsPath))
            {
                datContent = await File.ReadAllBytesAsync(modSettingsPath);
            }

            var modpack = new FactorioLibrary.Models.Modpack
            {
                Name = modpackName,
                TargetFactorioVersion = Instance?.AssignedVersion ?? "latest",
                ModListJson = jsonContent,
                ModSettingsDat = datContent
            };

            DbContext.Modpacks.Add(modpack);
            await DbContext.SaveChangesAsync();

            AvailableModpacks = await DbContext.Modpacks.ToListAsync();
            SuccessMessage = "Successfully saved Modpack!";
        }
        catch (Exception ex)
        {
            SyncError = $"Failed to save modpack: {ex.Message}";
        }
        finally
        {
            IsSavingModpack = false;
            StateHasChanged();
        }
    }
