    private string GetFriendlyTime(DateTime utcTime)
    {
        TimeSpan timeSpan = DateTime.UtcNow - utcTime;

        if (timeSpan <= TimeSpan.FromSeconds(60))
            return "Just now";
        if (timeSpan <= TimeSpan.FromMinutes(60))
            return timeSpan.Minutes > 1 ? $"{timeSpan.Minutes} mins ago" : "1 min ago";
        if (timeSpan <= TimeSpan.FromHours(24))
            return timeSpan.Hours > 1 ? $"{timeSpan.Hours} hours ago" : "1 hour ago";
        if (timeSpan <= TimeSpan.FromDays(30))
            return timeSpan.Days > 1 ? $"{timeSpan.Days} days ago" : "Yesterday";

        return utcTime.ToString("MMM dd, yyyy h:mm tt");
    }

    private string ExtractSaveVersion(string zipPath)
    {
        try
        {
            using System.IO.Compression.ZipArchive archive = System.IO.Compression.ZipFile.OpenRead(zipPath);
            // script.dat and level.dat contain the last saved version.
            // For massive multi-part Space Age saves, level.dat is split, so we must check script.dat first.
            System.IO.Compression.ZipArchiveEntry? entry = archive.Entries.FirstOrDefault(e => e.Name.Equals("script.dat", StringComparison.OrdinalIgnoreCase))
                        ?? archive.Entries.FirstOrDefault(e => e.Name.Equals("level.dat", StringComparison.OrdinalIgnoreCase))
                        ?? archive.Entries.FirstOrDefault(e => e.Name.Equals("level-init.dat", StringComparison.OrdinalIgnoreCase));

            if (entry != null)
            {
                using Stream stream = entry.Open();
                using System.IO.BinaryReader reader = new(stream);
                ushort major = reader.ReadUInt16();
                ushort minor = reader.ReadUInt16();
                ushort patch = reader.ReadUInt16();
                ushort build = reader.ReadUInt16();
                return $"{major}.{minor}.{patch}";
            }
        }
        catch
        {
            // Ignore extraction errors
        }
        return "";
    }

    private void LoadBackupFiles()
    {
        string backupsDir = InstanceManager.GetBackupsDirectory(Id);
        if (Directory.Exists(backupsDir))
        {
            // Only load completed zips (not .tmp files)
            backupFiles = Directory.GetFiles(backupsDir, "*.zip")
                .Select(f => new FileInfo(f))
                .Select(fi => new BackupFileInfo
                {
                    Name = fi.Name,
                    Created = fi.CreationTimeUtc,
                    SizeBytes = fi.Length
                })
                .OrderByDescending(x => x.Created)
                .ToList();
        }
        else
        {
            backupFiles = new();
        }
    }

    private async Task CreateZipArchive(string targetZipPath)
    {
        string instanceDir = InstanceManager.GetLocalDataPath(Id);
        string metaPath = Path.Combine(instanceDir, "server-meta.json");
        string metaJson = System.Text.Json.JsonSerializer.Serialize(instance, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        await File.WriteAllTextAsync(metaPath, metaJson);

        if (File.Exists(targetZipPath)) File.Delete(targetZipPath);

        await Task.Run(() => {
            System.IO.Compression.ZipFile.CreateFromDirectory(instanceDir, targetZipPath, System.IO.Compression.CompressionLevel.Fastest, false);
        });

        File.Delete(metaPath);
    }

    private async Task CreateBackup()
    {
        if (isBackingUp) return;
        
        InstanceManager.SetBackingUp(Id, true);
        StateHasChanged();

        try
        {
            string backupsDir = InstanceManager.GetBackupsDirectory(Id);
            string backupName = $"backup_{DateTime.UtcNow:yyyyMMdd_HHmmss}.zip";
            string tempZipPath = Path.Combine(backupsDir, backupName + ".tmp");
            string targetZipPath = Path.Combine(backupsDir, backupName);
            
            await CreateZipArchive(tempZipPath);
            File.Move(tempZipPath, targetZipPath);

            // Fetch max backups setting and apply retention
            FactorioLibrary.Models.GlobalSettings settings = GlobalSettingsService.GetSettings();
            if (settings.MaxServerBackups > 0)
            {
                var allBackups = Directory.GetFiles(backupsDir, "*.zip")
                    .Select(f => new FileInfo(f))
                    .OrderBy(f => f.CreationTimeUtc)
                    .ToList();

                int overage = allBackups.Count - settings.MaxServerBackups;
                if (overage > 0)
                {
                    foreach (var oldBackup in allBackups.Take(overage))
                    {
                        try { oldBackup.Delete(); } catch { }
                    }
                }
            }

            LoadBackupFiles();
        }
        finally
        {
            InstanceManager.SetBackingUp(Id, false);
            StateHasChanged();
        }
    }

    private async Task UploadBackup(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || !file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase)) return;

        isUploadingBackup = true;
        backupUploadProgress = 0;
        StateHasChanged();

        try
        {
            string backupsDir = InstanceManager.GetBackupsDirectory(Id);
            string safeName = Path.GetFileName(file.Name);
            string targetPath = Path.Combine(backupsDir, safeName);

            // Avoid overwriting by appending timestamp if it exists
            if (File.Exists(targetPath))
            {
                string nameWithoutExt = Path.GetFileNameWithoutExtension(safeName);
                safeName = $"{nameWithoutExt}_{DateTime.UtcNow.Ticks}.zip";
                targetPath = Path.Combine(backupsDir, safeName);
            }

            using (FileStream fs = new(targetPath, FileMode.Create))
            {
                using Stream readStream = file.OpenReadStream(10L * 1024 * 1024 * 1024); // 10GB max
                byte[] buffer = new byte[81920];
                int bytesRead;
                long totalRead = 0;
                while ((bytesRead = await readStream.ReadAsync(buffer)) > 0)
                {
                    await fs.WriteAsync(buffer.AsMemory(0, bytesRead));
                    totalRead += bytesRead;
                    backupUploadProgress = (int)((totalRead * 100) / file.Size);
                    StateHasChanged();
                }
            }

            LoadBackupFiles();
        }
        finally
        {
            isUploadingBackup = false;
            StateHasChanged();
        }
    }

    private async Task DeleteBackup(string name)
    {
        bool isConfirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to permanently delete the backup '{name}'?");
        if (!isConfirmed) return;

        string filePath = Path.Combine(InstanceManager.GetBackupsDirectory(Id), name);
        if (File.Exists(filePath))
        {
            File.Delete(filePath);
            LoadBackupFiles();
        }
    }

    private async Task RestoreBackup(string name)
    {
        if (isBackingUp) return;

        bool isConfirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to restore {name}? This will completely replace your current saves, mods, and configurations with the backup!");
        if (!isConfirmed) return;

        InstanceManager.SetBackingUp(Id, true);
        StateHasChanged();

        try
        {
            // Stop server first
            if (InstanceManager.IsRunning(Id))
                await InstanceManager.StopInstanceAsync(Id);

            string filePath = Path.Combine(InstanceManager.GetBackupsDirectory(Id), name);
            if (!File.Exists(filePath)) return;

            string instanceDir = InstanceManager.GetLocalDataPath(Id);
            
            // Delete all contents of instanceDir EXCEPT the backups directory
            foreach (string dir in Directory.GetDirectories(instanceDir))
            {
                if (Path.GetFileName(dir) == "backups") continue;
                Directory.Delete(dir, true);
            }
            foreach (string file in Directory.GetFiles(instanceDir))
            {
                File.Delete(file);
            }

            // Extract backup
            System.IO.Compression.ZipFile.ExtractToDirectory(filePath, instanceDir, true);

            // Reload state
            instance = await DbContext.ServerInstances.FirstOrDefaultAsync(x => x.Id == Id);
            LoadSaveFiles();
        }
        finally
        {
            InstanceManager.SetBackingUp(Id, false);
            StateHasChanged();
        }
    }

