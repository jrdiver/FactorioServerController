@page "/instance/{Id:int}"
@using FactorioLibrary.Data
@using FactorioLibrary.Models
@using FactorioLibrary.Services
@using FactorioLibrary
@using FactorioLibrary.Objects
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@inject AppDbContext DbContext
@inject InstanceManager InstanceManager
@inject NavigationManager Navigation
@inject FactorioWebApi WebApi
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<IdentityUser> UserManager
@implements IDisposable

<script>
    window.formatLocalTimes = () => {
        document.querySelectorAll('.local-time').forEach(el => {
            const utc = el.getAttribute('data-utc');
            if (utc) {
                const date = new Date(utc);
                el.title = date.toLocaleString(undefined, { 
                    month: 'short', day: 'numeric', year: 'numeric', 
                    hour: 'numeric', minute: '2-digit', hour12: true 
                }) + ' (Local)';
            }
        });
    }
</script>

<PageTitle>Server Settings - @(Instance?.Name ?? "Loading...")</PageTitle>

@if (Instance == null)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-accent" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    bool isRunning = InstanceManager.IsRunning(Instance.Id);

    <NavigationLock ConfirmExternalNavigation="IsUploading" OnBeforeInternalNavigation="OnBeforeInternalNavigation" />

    <div class="container-fluid py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a href="/" class="btn btn-glass-secondary mb-3"><i class="bi bi-arrow-left me-2"></i>Back to Dashboard</a>
                <h1 class="display-6 text-accent mb-0">
                    <span class="status-dot @(isRunning ? "running" : "stopped")" title="@(isRunning ? "Running" : "Stopped")"></span>
                    @Instance.Name
                </h1>
            </div>
            
            <div class="d-flex gap-2">
                @if (!IsViewer)
                {
                    @if (isRunning)
                    {
                        @if (IsStopping)
                        {
                            <button class="btn btn-glass-secondary text-danger" disabled><span class="spinner-border spinner-border-sm me-2"></span>Stopping...</button>
                        }
                        else
                        {
                            <button class="btn btn-glass-secondary text-danger" @onclick="StopServer"><i class="bi bi-stop-fill me-2"></i>Stop Server</button>
                        }
                    }
                    else if (IsStarting)
                    {
                        <button class="btn btn-glass" disabled><span class="spinner-border spinner-border-sm me-2"></span>Starting...</button>
                    }
                    else
                    {
                        <button class="btn btn-glass" @onclick="StartServer"><i class="bi bi-play-fill me-2"></i>Start Server</button>
                    }
                }
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8">
                @if (InstanceManager.IsRunning(Id))
                {
                    <InstanceDashboard Id="@Id" />
                }

                <div class="glass-card mb-4">
                    <h4 class="mb-4"><i class="bi bi-sliders me-2"></i>General Settings</h4>
                    
                    <EditForm Model="@Instance" OnValidSubmit="SaveChanges">
                        <DataAnnotationsValidator />
                        <fieldset disabled="@IsViewer">
                        
                        <div class="mb-3">
                            <label class="form-label text-muted">Server Name</label>
                            <InputText @bind-Value="Instance.Name" class="form-control bg-transparent text-white border-secondary" />
                            <ValidationMessage For="@(() => Instance.Name)" />
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted">Game Port</label>
                                <InputNumber @bind-Value="Instance.Port" class="form-control bg-transparent text-white border-secondary" />
                                <ValidationMessage For="@(() => Instance.Port)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted">Factorio Version</label>
                                <InputSelect @bind-Value="Instance.AssignedVersion" class="form-select bg-transparent text-white border-secondary">
                                    @foreach (var v in AvailableVersions)
                                    {
                                        <option value="@v.Tag" class="text-dark">@v.DisplayName</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => Instance.AssignedVersion)" />
                            </div>
                        </div>

                        <h5 class="mt-4 mb-3 text-muted border-bottom border-secondary pb-2"><i class="bi bi-terminal me-2"></i>RCON Configuration</h5>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label class="form-label text-muted">RCON Port</label>
                                <InputNumber @bind-Value="Instance.RconPort" autocomplete="new-password" class="form-control bg-transparent text-white border-secondary" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted">RCON Password</label>
                                <div class="input-group">
                                    <InputText @bind-Value="Instance.RconPassword" type="@(ShowRconPassword ? "text" : "password")" autocomplete="new-password" class="form-control bg-transparent text-white border-secondary" />
                                    <button type="button" class="btn btn-outline-secondary border-secondary text-muted" @onclick="() => ShowRconPassword = !ShowRconPassword">
                                        <i class="bi @(ShowRconPassword ? "bi-eye-slash" : "bi-eye")"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            @if (ShowSaveSuccess)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill me-2"></i>Settings saved successfully!</span>
                            }
                            else
                            {
                                <span></span>
                            }
                            @if (!IsViewer)
                            {
                                <button type="submit" class="btn btn-glass"><i class="bi bi-save-fill me-2"></i>Save Changes</button>
                            }
                        </div>
                        </fieldset>
                    </EditForm>
                </div>

                <div class="glass-card mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h4 class="mb-0"><i class="bi bi-floppy me-2"></i>Saves Management</h4>
                        <div>
                            @if (!IsViewer)
                            {
                                <InputFile OnChange="UploadSaveFile" class="d-none" id="saveUpload" accept=".zip" />
                                <button class="btn btn-glass-secondary" type="button" onclick="document.getElementById('saveUpload').click()" disabled="@IsUploading">
                                    @if (IsUploading)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Uploading... @UploadProgress%</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-upload me-2"></i><span>Upload Save</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                    
                    @if (IsUploading)
                    {
                        <div class="progress mb-4" style="height: 10px; background-color: rgba(255,255,255,0.1);">
                            <div class="progress-bar bg-accent progress-bar-striped progress-bar-animated" role="progressbar" style="width: @UploadProgress%"></div>
                        </div>
                    }

                    @if (HasCorruptedTempSave)
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>Warning:</strong> A corrupted <code>.tmp.zip</code> save file was detected, indicating the server crashed or was killed before it could finish saving the map. The corrupted file has been hidden and will be automatically deleted the next time you start the server so it doesn't crash on boot.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(UploadError))
                    {
                        <div class="alert alert-danger">@UploadError</div>
                    }

                    @if (SaveFiles == null)
                    {
                        <div class="text-center text-muted"><span class="spinner-border spinner-border-sm me-2"></span> Loading saves...</div>
                    }
                    else if (!SaveFiles.Any())
                    {
                        <div class="text-center text-muted my-4">
                            <i class="bi bi-folder2-open display-4 mb-3 d-block"></i>
                            No saves found for this instance.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-borderless align-middle mb-0">
                                <thead class="border-bottom border-secondary">
                                    <tr>
                                        <th class="text-muted">Filename</th>
                                        <th class="text-muted">Save Version</th>
                                        <th class="text-muted">Last Modified</th>
                                        <th class="text-muted text-end">Size</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (SaveFileInfo save in SaveFiles)
                                    {
                                        <tr>
                                            <td>
                                                <i class="bi bi-file-zip text-accent me-2"></i>
                                                <span class="text-white">@save.Name</span>
                                            </td>
                                            <td class="text-secondary">
                                                @if (string.IsNullOrEmpty(save.SaveVersion))
                                                {
                                                    <span class="text-muted">Unknown</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-dark border border-secondary text-light">@save.SaveVersion</span>
                                                }
                                            </td>
                                            <td class="text-muted local-time" data-utc="@save.LastModified.ToString("O")" title="@save.LastModified.ToString("MMM dd, yyyy h:mm tt 'UTC'")">
                                                @GetFriendlyTime(save.LastModified)
                                                @if (string.IsNullOrEmpty(Instance?.ActiveSaveName) && save == SaveFiles.First())
                                                {
                                                    <span class="badge bg-secondary ms-2" title="Will auto-load because it is the newest save">Auto-Active</span>
                                                }
                                            </td>
                                            <td class="text-muted text-end">@FormatBytes(save.SizeBytes)</td>
                                            <td class="text-end">
                                                @if (!IsViewer)
                                                {
                                                    @if (Instance?.ActiveSaveName == save.Name)
                                                    {
                                                        <button class="btn btn-sm btn-glass-secondary text-success me-2" @onclick="ClearActiveSave" title="Currently Active (Click to clear)">
                                                            <i class="bi bi-star-fill"></i> Active
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <button class="btn btn-sm btn-glass-secondary me-2" @onclick="() => SetActiveSave(save.Name)" title="Set as Active Save">
                                                            <i class="bi bi-star"></i> Set Active
                                                        </button>
                                                    }
                                                }
                                                <a href="/api/instances/@Id/saves/@Uri.EscapeDataString(save.Name)" download class="btn btn-sm btn-glass-secondary me-2" title="Download">
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                @if (!IsViewer)
                                                {
                                                    <button class="btn btn-sm btn-glass-secondary text-danger" @onclick="() => DeleteSaveFile(save.Name)" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-muted small mt-3">
                            <i class="bi bi-info-circle me-1"></i> 
                            @if (string.IsNullOrEmpty(Instance?.ActiveSaveName))
                            {
                                <span>The Factorio server automatically loads the most recently modified save file when it starts.</span>
                            }
                            else
                            {
                                <span>The Factorio server is locked to load <strong class="text-white">@Instance.ActiveSaveName</strong> when it starts.</span>
                            }
                        </div>
                    }
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="glass-card mb-4">
                    <h4 class="mb-4"><i class="bi bi-info-circle me-2"></i>Quick Actions</h4>
                    <div class="d-grid gap-2">
                        <a href="/instance/@Id/mods" class="btn btn-glass-secondary text-start"><i class="bi bi-puzzle me-2"></i>Manage Mods</a>
                        <a href="/instance/@Id/console" class="btn btn-glass-secondary text-start"><i class="bi bi-terminal me-2"></i>Server Console</a>
                        @if (!IsViewer)
                        {
                            <a href="/instance/@Id/settings" class="btn btn-glass-secondary text-start"><i class="bi bi-file-earmark-text me-2"></i>Edit server-settings.json</a>
                        }
                        <AuthorizeView Roles="Administrator">
                            <Authorized>
                                <hr class="border-secondary my-2" />
                                <button class="btn btn-glass-secondary text-start text-warning" @onclick="PromptResetConfigs"><i class="bi bi-arrow-counterclockwise me-2"></i>Reset Configs</button>
                                <button class="btn btn-glass-secondary text-start text-danger" @onclick="PromptDeleteServer"><i class="bi bi-trash me-2"></i>Delete Server</button>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowResetConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.7);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Reset</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelResetConfigs"></button>
                </div>
                <div class="modal-body">
                    <p class="text-white mb-2">Are you sure you want to reset configs for <strong>@Instance?.Name</strong>?</p>
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>Warning:</strong> This will completely wipe the <code>config/</code> directory and <code>player-data.json</code>.
                        <br/><br/>
                        Use this if the server fails to start after downgrading Factorio versions or if you want to restore default settings.
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-glass-secondary" @onclick="CancelResetConfigs">Cancel</button>
                    <button type="button" class="btn btn-warning" @onclick="ConfirmResetConfigs">
                        <span><i class="bi bi-arrow-counterclockwise me-2"></i>Reset Configs</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (ShowDeleteConfirmation)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.7);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content glass-card">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CancelDeleteServer"></button>
                </div>
                <div class="modal-body">
                    <p class="text-white mb-2">Are you sure you want to delete <strong>@Instance?.Name</strong>?</p>
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        <strong>Warning:</strong> This will completely remove the server, delete its Docker container, and permanently erase all save files, configs, and mods from the disk!
                        <br/><br/>
                        Please ensure you have downloaded any save files or mods you want to keep before proceeding.
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-glass-secondary" @onclick="CancelDeleteServer">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDeleteServer" disabled="@IsDeleting">
                        @if (IsDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <span><i class="bi bi-trash me-2"></i>Permanently Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ServerInstance? Instance;
    private List<DockerTagInfo> AvailableVersions = new();
    private bool ShowSaveSuccess = false;
    private List<SaveFileInfo>? SaveFiles;
    private bool HasUpdateAvailable = false;
    private bool IsStarting = false;
    private bool IsStopping = false;
    private bool IsUploading = false;
    private string? UploadError;
    private int UploadProgress = 0;
    private bool ShowDeleteConfirmation = false;
    private bool IsDeleting = false;
    private bool ShowResetConfirmation = false;
    private bool ShowRconPassword = false;
    private bool HasCorruptedTempSave = false;
    private bool IsViewer = false;

    private class SaveFileInfo
    {
        public string Name { get; set; } = "";
        public DateTime LastModified { get; set; }
        public long SizeBytes { get; set; }
        public string SaveVersion { get; set; } = "";
    }

    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        IdentityUser? user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        bool isAdmin = await UserManager.IsInRoleAsync(user, "Administrator");
        if (!isAdmin)
        {
            UserServerAccess? access = await DbContext.UserServerAccesses.FirstOrDefaultAsync(usa => usa.UserId == user.Id && usa.ServerInstanceId == Id);
            if (access == null)
            {
                Navigation.NavigateTo("/");
                return;
            }
            IsViewer = access.AccessLevel == ServerAccessLevel.Viewer;
        }

        Instance = await DbContext.ServerInstances.FirstOrDefaultAsync(x => x.Id == Id);
        if (Instance == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        LoadSaveFiles();

        try
        {
            AvailableVersions = await WebApi.GetDockerTagsAsync();
        }
        catch
        {
            // Fallback if API fails
            AvailableVersions = new List<DockerTagInfo> { 
                new("latest", "latest"), 
                new("stable", "stable"), 
                new("2.1", "2.1"), 
                new("2.0", "2.0") 
            };
        }

        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollStatusAsync();
    }

    private async Task PollStatusAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                bool isHidden = false;
                try
                {
                    isHidden = await JSRuntime.InvokeAsync<bool>("eval", "document.hidden");
                }
                catch { }

                if (!isHidden)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try 
        {
            await JSRuntime.InvokeVoidAsync("formatLocalTimes");
        }
        catch { }
    }

    private async Task SaveChanges()
    {
        if (Instance != null)
        {
            DbContext.ServerInstances.Update(Instance);
            await DbContext.SaveChangesAsync();
            
            ShowSaveSuccess = true;
            StateHasChanged();
            
            // Hide success message after 3 seconds
            await Task.Delay(3000);
            ShowSaveSuccess = false;
            StateHasChanged();
        }
    }

    private void PromptResetConfigs()
    {
        ShowResetConfirmation = true;
    }

    private void CancelResetConfigs()
    {
        ShowResetConfirmation = false;
    }

    private void ConfirmResetConfigs()
    {
        ShowResetConfirmation = false;
        InstanceManager.FactoryResetConfigs(Id);
        StateHasChanged();
        
        // Let the user know via a small UI update if we want, or just rely on them seeing the modal close
    }

    private async Task StartServer()
    {
        if (Instance != null)
        {
            IsStarting = true;
            StateHasChanged();
            
            var result = await InstanceManager.StartInstanceAsync(Instance);
            
            IsStarting = false;
            
            if (result.CleanedCorruptSave)
            {
                // We'll let the user know, but they already see the warning banner on this page
                HasCorruptedTempSave = false; // It's deleted now!
            }
            
            StateHasChanged();
        }
    }

    private async Task StopServer()
    {
        IsStopping = true;
        StateHasChanged();
        
        await InstanceManager.StopInstanceAsync(Id);
        
        IsStopping = false;
        StateHasChanged();
    }

    private void PromptDeleteServer()
    {
        ShowDeleteConfirmation = true;
    }

    private void CancelDeleteServer()
    {
        ShowDeleteConfirmation = false;
    }

    private async Task ConfirmDeleteServer()
    {
        if (Instance != null)
        {
            IsDeleting = true;
            StateHasChanged();
            
            // Delete docker container and all host files
            await InstanceManager.DeleteInstanceDataAsync(Id);
            
            // Remove from DB
            DbContext.ServerInstances.Remove(Instance);
            await DbContext.SaveChangesAsync();
            Navigation.NavigateTo("/");
        }
    }

    private async Task OnBeforeInternalNavigation(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (IsUploading)
        {
            bool isConfirmed = await JSRuntime.InvokeAsync<bool>("confirm", "A save file upload is currently in progress. If you leave this page, the upload will be cancelled. Are you sure you want to leave?");
            if (!isConfirmed)
            {
                context.PreventNavigation();
            }
        }
    }

    private void LoadSaveFiles()
    {
        try
        {
            string savesDir = InstanceManager.GetSavesDirectory(Id);
            if (!Directory.Exists(savesDir))
            {
                Directory.CreateDirectory(savesDir);
            }

            DirectoryInfo dirInfo = new DirectoryInfo(savesDir);
            
            HasCorruptedTempSave = dirInfo.GetFiles("*.tmp.zip").Any();
            
            SaveFiles = dirInfo.GetFiles("*.zip")
                .Where(f => !f.Name.EndsWith(".tmp.zip", StringComparison.OrdinalIgnoreCase))
                .Select(f => new SaveFileInfo
                {
                    Name = f.Name,
                    LastModified = f.LastWriteTimeUtc,
                    SizeBytes = f.Length,
                    SaveVersion = ExtractSaveVersion(f.FullName)
                })
                .OrderByDescending(s => s.LastModified)
                .ToList();
        }
        catch (Exception)
        {
            SaveFiles = new List<SaveFileInfo>();
        }
    }

    private async Task UploadSaveFile(InputFileChangeEventArgs e)
    {
        Microsoft.AspNetCore.Components.Forms.IBrowserFile file = e.File;
        if (file == null) return;
        if (!file.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
        {
            UploadError = "Only .zip save files are allowed.";
            return;
        }

        IsUploading = true;
        UploadProgress = 0;
        UploadError = null;
        StateHasChanged();

        try
        {
            string savesDir = InstanceManager.GetSavesDirectory(Id);
            if (!Directory.Exists(savesDir)) Directory.CreateDirectory(savesDir);

            string path = Path.Combine(savesDir, file.Name);
            long totalBytes = file.Size;
            long bytesRead = 0;

            // Allow up to 2GB max file size
            await using Stream stream = file.OpenReadStream(2147483648);
            await using FileStream fs = new FileStream(path, FileMode.Create, FileAccess.Write, FileShare.None, 81920, true);
            
            byte[] buffer = new byte[81920];
            int read;
            while ((read = await stream.ReadAsync(buffer)) > 0)
            {
                await fs.WriteAsync(buffer, 0, read);
                bytesRead += read;
                int newProgress = (int)((double)bytesRead / totalBytes * 100);
                if (newProgress > UploadProgress)
                {
                    UploadProgress = newProgress;
                    StateHasChanged();
                }
            }

            LoadSaveFiles(); // Refresh list
        }
        catch (Exception ex)
        {
            UploadError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            IsUploading = false;
            StateHasChanged();
        }
    }

    private void DeleteSaveFile(string filename)
    {
        try
        {
            string savesDir = InstanceManager.GetSavesDirectory(Id);
            string path = Path.Combine(savesDir, filename);
            if (File.Exists(path))
            {
                File.Delete(path);
                LoadSaveFiles();
            }
        }
        catch { }
    }

    private string FormatBytes(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = (decimal)bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number = number / 1024;
            counter++;
        }
        return string.Format("{0:n1} {1}", number, suffixes[counter]);
    }

    private async Task SetActiveSave(string filename)
    {
        if (Instance != null)
        {
            Instance.ActiveSaveName = filename;
            await SaveChanges();
        }
    }

    private async Task ClearActiveSave()
    {
        if (Instance != null)
        {
            Instance.ActiveSaveName = null;
            await SaveChanges();
        }
    }

    private string GetFriendlyTime(DateTime utcTime)
    {
        TimeSpan timeSpan = DateTime.UtcNow - utcTime;

        if (timeSpan <= TimeSpan.FromSeconds(60))
            return "Just now";
        if (timeSpan <= TimeSpan.FromMinutes(60))
            return timeSpan.Minutes > 1 ? $"{timeSpan.Minutes} mins ago" : "1 min ago";
        if (timeSpan <= TimeSpan.FromHours(24))
            return timeSpan.Hours > 1 ? $"{timeSpan.Hours} hours ago" : "1 hour ago";
        if (timeSpan <= TimeSpan.FromDays(30))
            return timeSpan.Days > 1 ? $"{timeSpan.Days} days ago" : "Yesterday";

        return utcTime.ToString("MMM dd, yyyy h:mm tt");
    }

    private string ExtractSaveVersion(string zipPath)
    {
        try
        {
            using System.IO.Compression.ZipArchive archive = System.IO.Compression.ZipFile.OpenRead(zipPath);
            // script.dat and level.dat contain the last saved version. 
            // For massive multi-part Space Age saves, level.dat is split, so we must check script.dat first.
            System.IO.Compression.ZipArchiveEntry? entry = archive.Entries.FirstOrDefault(e => e.Name.Equals("script.dat", StringComparison.OrdinalIgnoreCase))
                        ?? archive.Entries.FirstOrDefault(e => e.Name.Equals("level.dat", StringComparison.OrdinalIgnoreCase)) 
                        ?? archive.Entries.FirstOrDefault(e => e.Name.Equals("level-init.dat", StringComparison.OrdinalIgnoreCase));
            
            if (entry != null)
            {
                using Stream stream = entry.Open();
                using System.IO.BinaryReader reader = new System.IO.BinaryReader(stream);
                ushort major = reader.ReadUInt16();
                ushort minor = reader.ReadUInt16();
                ushort patch = reader.ReadUInt16();
                ushort build = reader.ReadUInt16();
                return $"{major}.{minor}.{patch}";
            }
        }
        catch
        {
            // Ignore extraction errors
        }
        return "";
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }
}
