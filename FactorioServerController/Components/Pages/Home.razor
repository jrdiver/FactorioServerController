@page "/"
@using FactorioLibrary
@using FactorioLibrary.Data
@using FactorioLibrary.Models
@using FactorioLibrary.Objects
@using FactorioLibrary.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject InstanceManager InstanceManager
@inject NavigationManager Navigation
@inject FactorioWebApi WebApi
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<IdentityUser> UserManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="display-5 text-accent mb-0"><i class="bi bi-cpu-fill me-2"></i>Factorio Instances</h1>
            <p class="text-muted mt-2">Manage your servers and processes</p>
        </div>
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <div class="col-auto">
                    <button class="btn btn-glass" @onclick="CreateNewInstance"><i class="bi bi-plus-lg me-2"></i>New Instance</button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrEmpty(DashboardAlert))
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Notice:</strong> @DashboardAlert
            <button type="button" class="btn-close" @onclick="() => DashboardAlert = null"></button>
        </div>
    }

    @if (Instances == null)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="spinner-border text-accent" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!Instances.Any())
    {
        <div class="glass-panel p-5 text-center mt-4">
            <i class="bi bi-hdd-network display-1 text-muted mb-3 d-block"></i>
            <h3>No instances found</h3>
            <p class="text-muted mb-4">You don't have any Factorio servers configured yet.</p>
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <button class="btn btn-glass" @onclick="CreateNewInstance">Create Your First Server</button>
                </Authorized>
            </AuthorizeView>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 g-4">
            @foreach (ServerInstance instance in Instances)
            {
                bool isRunning = InstanceManager.IsRunning(instance.Id);
                
                <div class="col">
                    <div class="glass-card h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h4 class="mb-0 text-truncate">@instance.Name</h4>
                            <div class="d-flex align-items-center">
                                <span class="status-dot @(isRunning ? "running" : "stopped")" title="@(isRunning ? "Running" : "Stopped")"></span>
                            </div>
                        </div>
                        
                        <div class="text-muted small mb-4 flex-grow-1">
                            <div class="mb-1"><i class="bi bi-hdd-fill me-2"></i>Port: <strong>@instance.Port</strong></div>
                            @if (!_viewerStatus.GetValueOrDefault(instance.Id))
                            {
                                <div class="mb-1"><i class="bi bi-terminal-fill me-2"></i>RCON: <strong>@instance.RconPort</strong></div>
                            }
                            <div class="mb-1"><i class="bi bi-tag-fill me-2"></i>Version: <strong>@GetVersionDisplayName(instance.AssignedVersion)</strong></div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            @if (_viewerStatus.GetValueOrDefault(instance.Id))
                            {
                                <button class="btn btn-glass-secondary flex-grow-1" disabled>
                                    <i class="bi bi-eye-fill me-1"></i> View Only
                                </button>
                            }
                            else if (isRunning)
                            {
                                @if (_stoppingInstances.Contains(instance.Id))
                                {
                                    <button class="btn btn-glass-secondary flex-grow-1 text-danger" disabled>
                                        <span class="spinner-border spinner-border-sm me-1"></span> Stopping...
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-glass-secondary flex-grow-1 text-danger" @onclick="() => StopInstance(instance.Id)">
                                        <i class="bi bi-stop-fill me-1"></i> Stop
                                    </button>
                                }
                            }
                            else
                            {
                                @if (_startingInstances.Contains(instance.Id))
                                {
                                    <button class="btn btn-glass flex-grow-1" disabled>
                                        <span class="spinner-border spinner-border-sm me-1"></span> Starting...
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-glass flex-grow-1" @onclick="() => StartInstance(instance)">
                                        <i class="bi bi-play-fill me-1"></i> Start
                                    </button>
                                }
                            }
                            <a href="/instance/@instance.Id/console" class="btn btn-glass-secondary text-accent" title="Server Console">
                                <i class="bi bi-terminal-fill"></i>
                            </a>
                            <a href="/instance/@instance.Id" class="btn btn-glass-secondary" title="Settings"><i class="bi bi-gear-fill"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ServerInstance>? Instances;
    private List<DockerTagInfo> AvailableVersions = new();
    private HashSet<int> _startingInstances = new();
    private HashSet<int> _stoppingInstances = new();
    private Dictionary<int, bool> _viewerStatus = new();
    private PeriodicTimer? _timer;
    private CancellationTokenSource _cts = new();
    private string? DashboardAlert;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstances();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = PollStatusAsync();
    }

    private async Task PollStatusAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(_cts.Token))
            {
                bool isHidden = false;
                try
                {
                    isHidden = await JSRuntime.InvokeAsync<bool>("eval", "document.hidden");
                }
                catch { }

                if (!isHidden)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadInstances()
    {
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        IdentityUser? user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null)
        {
            Instances = new();
            return;
        }

        bool isAdmin = await UserManager.IsInRoleAsync(user, "Administrator");

        if (isAdmin)
        {
            Instances = await DbContext.ServerInstances.ToListAsync();
            foreach(var instance in Instances)
            {
                _viewerStatus[instance.Id] = false;
            }
        }
        else
        {
            var accesses = await DbContext.UserServerAccesses
                .Where(usa => usa.UserId == user.Id)
                .ToListAsync();
                
            List<int> allowedServerIds = accesses.Select(usa => usa.ServerInstanceId).ToList();
                
            Instances = await DbContext.ServerInstances
                .Where(s => allowedServerIds.Contains(s.Id))
                .ToListAsync();
                
            foreach(var instance in Instances)
            {
                var access = accesses.FirstOrDefault(a => a.ServerInstanceId == instance.Id);
                _viewerStatus[instance.Id] = access?.AccessLevel == ServerAccessLevel.Viewer;
            }
        }
        
        try
        {
            AvailableVersions = await WebApi.GetDockerTagsAsync();
        }
        catch
        {
            AvailableVersions = new();
        }
    }

    private string GetVersionDisplayName(string? tag)
    {
        if (string.IsNullOrEmpty(tag) || tag == "latest") return AvailableVersions.FirstOrDefault(v => v.Tag == "latest")?.DisplayName ?? "Latest";
        if (tag == "stable") return AvailableVersions.FirstOrDefault(v => v.Tag == "stable")?.DisplayName ?? "Stable";
        
        var info = AvailableVersions.FirstOrDefault(v => v.Tag == tag);
        return info?.DisplayName ?? tag;
    }

    private async Task StartInstance(ServerInstance instance)
    {
        DashboardAlert = null; // Clear previous alerts
        _startingInstances.Add(instance.Id);
        StateHasChanged();
        
        var result = await InstanceManager.StartInstanceAsync(instance);
        
        if (result.CleanedCorruptSave)
        {
            DashboardAlert = $"A corrupted .tmp.zip save file was automatically detected and deleted while starting {instance.Name} to prevent a boot crash.";
        }
        
        _startingInstances.Remove(instance.Id);
        StateHasChanged();
    }

    private async Task StopInstance(int instanceId)
    {
        _stoppingInstances.Add(instanceId);
        StateHasChanged();
        
        await InstanceManager.StopInstanceAsync(instanceId);
        
        _stoppingInstances.Remove(instanceId);
        StateHasChanged();
    }

    private async Task CreateNewInstance()
    {
        ServerInstance newInstance = new ServerInstance
        {
            Name = $"Factorio Server #{Instances?.Count + 1 ?? 1}",
            Port = 34197 + (Instances?.Count ?? 0),
            RconPort = 27015 + (Instances?.Count ?? 0),
            RconPassword = Guid.NewGuid().ToString("N").Substring(0, 8)
        };

        DbContext.ServerInstances.Add(newInstance);
        await DbContext.SaveChangesAsync();
        
        Navigation.NavigateTo($"/instance/{newInstance.Id}");
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _timer?.Dispose();
    }
}
