@page "/"
@using FactorioLibrary
@using FactorioLibrary.Data
@using FactorioLibrary.Models
@using FactorioLibrary.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject AppDbContext DbContext
@inject InstanceManager InstanceManager
@inject NavigationManager Navigation
@inject FactorioWebApi WebApi
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<IdentityUser> UserManager
@inject IJSRuntime JsRuntime
@implements IDisposable

<PageTitle>Dashboard</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="display-5 text-accent mb-0"><i class="bi bi-cpu-fill me-2"></i>Factorio Instances</h1>
            <p class="text-muted mt-2">Manage your servers and processes</p>
        </div>
        <AuthorizeView Roles="Administrator">
            <Authorized>
                <div class="col-auto d-flex gap-2">
                    <InputFile OnChange="ImportInstance" class="d-none" id="importUpload" accept=".zip" />
                    <button class="btn btn-glass-secondary" type="button" onclick="document.getElementById('importUpload').click()" disabled="@isImporting">
                        @if (isImporting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Importing... @importProgress%</span>
                        }
                        else
                        {
                            <i class="bi bi-box-arrow-in-down me-2"></i><span>Import Server</span>
                        }
                    </button>
                    <button class="btn btn-glass" @onclick="CreateNewInstance"><i class="bi bi-plus-lg me-2"></i>New Instance</button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    @if (!string.IsNullOrEmpty(dashboardAlert))
    {
        <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Notice:</strong> @dashboardAlert
            <button type="button" class="btn-close" @onclick="() => dashboardAlert = null"></button>
        </div>
    }

    @if (instances == null)
    {
        <div class="d-flex justify-content-center mt-5">
            <div class="spinner-border text-accent" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!instances.Any())
    {
        <div class="glass-panel p-5 text-center mt-4">
            <i class="bi bi-hdd-network display-1 text-muted mb-3 d-block"></i>
            <h3>No instances found</h3>
            <p class="text-muted mb-4">You don't have any Factorio servers configured yet.</p>
            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <button class="btn btn-glass" @onclick="CreateNewInstance">Create Your First Server</button>
                </Authorized>
            </AuthorizeView>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-lg-2 row-cols-xl-3 g-4">
            @foreach (ServerInstance instance in instances)
            {
                bool isRunning = InstanceManager.IsRunning(instance.Id);
                
                <div class="col">
                    <div class="glass-card h-100 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h4 class="mb-0 text-truncate">@instance.Name</h4>
                            <div class="d-flex align-items-center">
                                <span class="status-dot @(isRunning ? "running" : "stopped")" title="@(isRunning ? "Running" : "Stopped")"></span>
                            </div>
                        </div>
                        
                        <div class="text-muted small mb-4 flex-grow-1">
                            <div class="mb-1"><i class="bi bi-hdd-fill me-2"></i>Port: <strong>@instance.Port</strong></div>
                            @if (!viewerStatus.GetValueOrDefault(instance.Id))
                            {
                                <div class="mb-1"><i class="bi bi-terminal-fill me-2"></i>RCON: <strong>@instance.RconPort</strong></div>
                            }
                            <div class="mb-1"><i class="bi bi-tag-fill me-2"></i>Version: <strong>@GetVersionDisplayName(instance.AssignedVersion)</strong></div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            @if (viewerStatus.GetValueOrDefault(instance.Id))
                            {
                                <button class="btn btn-glass-secondary flex-grow-1" disabled>
                                    <i class="bi bi-eye-fill me-1"></i> View Only
                                </button>
                            }
                            else if (isRunning)
                            {
                                @if (stoppingInstances.Contains(instance.Id))
                                {
                                    <button class="btn btn-glass-secondary flex-grow-1 text-danger" disabled>
                                        <span class="spinner-border spinner-border-sm me-1"></span> Stopping...
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-glass-secondary flex-grow-1 text-danger" @onclick="() => StopInstance(instance.Id)">
                                        <i class="bi bi-stop-fill me-1"></i> Stop
                                    </button>
                                }
                            }
                            else
                            {
                                @if (startingInstances.Contains(instance.Id))
                                {
                                    <button class="btn btn-glass flex-grow-1" disabled>
                                        <span class="spinner-border spinner-border-sm me-1"></span> Starting...
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-glass flex-grow-1" @onclick="() => StartInstance(instance)">
                                        <i class="bi bi-play-fill me-1"></i> Start
                                    </button>
                                }
                            }
                            <a href="/instance/@instance.Id/console" class="btn btn-glass-secondary text-accent" title="Server Console">
                                <i class="bi bi-terminal-fill"></i>
                            </a>
                            <a href="/instance/@instance.Id" class="btn btn-glass-secondary" title="Settings"><i class="bi bi-gear-fill"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ServerInstance>? instances;
    private List<DockerTagInfo> availableVersions = new();
    private HashSet<int> startingInstances = new();
    private HashSet<int> stoppingInstances = new();
    private Dictionary<int, bool> viewerStatus = new();
    private PeriodicTimer? timer;
    private CancellationTokenSource cts = new();
    private string? dashboardAlert;
    
    private bool isImporting;
    private int importProgress;

    protected override async Task OnInitializedAsync()
    {
        await LoadInstances();
        timer = new(TimeSpan.FromSeconds(2));
        _ = PollStatusAsync();
    }

    private async Task PollStatusAsync()
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(cts.Token))
            {
                bool isHidden = false;
                try
                {
                    isHidden = await JsRuntime.InvokeAsync<bool>("eval", "document.hidden");
                }
                catch { }

                if (!isHidden)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) { }
    }

    private async Task LoadInstances()
    {
        AuthenticationState authState = await AuthStateProvider.GetAuthenticationStateAsync();
        IdentityUser? user = await UserManager.GetUserAsync(authState.User);
        
        if (user == null)
        {
            instances = new();
            return;
        }

        bool isAdmin = await UserManager.IsInRoleAsync(user, "Administrator");

        if (isAdmin)
        {
            instances = await DbContext.ServerInstances.ToListAsync();
            foreach(ServerInstance instance in instances)
            {
                viewerStatus[instance.Id] = false;
            }
        }
        else
        {
            List<UserServerAccess> accesses = await DbContext.UserServerAccesses
                .Where(usa => usa.UserId == user.Id)
                .ToListAsync();
                
            List<int> allowedServerIds = accesses.Select(usa => usa.ServerInstanceId).ToList();
                
            instances = await DbContext.ServerInstances
                .Where(s => allowedServerIds.Contains(s.Id))
                .ToListAsync();
                
            foreach(ServerInstance instance in instances)
            {
                UserServerAccess? access = accesses.FirstOrDefault(a => a.ServerInstanceId == instance.Id);
                viewerStatus[instance.Id] = access?.AccessLevel == ServerAccessLevel.Viewer || access?.AccessLevel == ServerAccessLevel.ViewerWithDownload;
            }
        }
        
        try
        {
            availableVersions = await WebApi.GetDockerTagsAsync();
        }
        catch
        {
            availableVersions = new();
        }
    }

    private string GetVersionDisplayName(string? tag)
    {
        if (string.IsNullOrEmpty(tag) || tag == "latest") return availableVersions.FirstOrDefault(v => v.Tag == "latest")?.DisplayName ?? "Latest";
        if (tag == "stable") return availableVersions.FirstOrDefault(v => v.Tag == "stable")?.DisplayName ?? "Stable";
        
        DockerTagInfo? info = availableVersions.FirstOrDefault(v => v.Tag == tag);
        return info?.DisplayName ?? tag;
    }

    private async Task StartInstance(ServerInstance instance)
    {
        dashboardAlert = null; // Clear previous alerts
        startingInstances.Add(instance.Id);
        StateHasChanged();
        
        (bool Success, bool CleanedCorruptSave) result = await InstanceManager.StartInstanceAsync(instance);
        
        if (result.CleanedCorruptSave)
        {
            dashboardAlert = $"A corrupted .tmp.zip save file was automatically detected and deleted while starting {instance.Name} to prevent a boot crash.";
        }
        
        startingInstances.Remove(instance.Id);
        StateHasChanged();
    }

    private async Task StopInstance(int instanceId)
    {
        stoppingInstances.Add(instanceId);
        StateHasChanged();
        
        await InstanceManager.StopInstanceAsync(instanceId);
        
        stoppingInstances.Remove(instanceId);
        StateHasChanged();
    }

    private async Task CreateNewInstance()
    {
        ServerInstance newInstance = new()
        {
            Name = $"Factorio Server #{instances?.Count + 1 ?? 1}",
            Port = 34197 + (instances?.Count ?? 0),
            RconPort = 27015 + (instances?.Count ?? 0),
            RconPassword = Guid.NewGuid().ToString("N").Substring(0, 8)
        };

        DbContext.ServerInstances.Add(newInstance);
        await DbContext.SaveChangesAsync();
        
        Navigation.NavigateTo($"/instance/{newInstance.Id}");
    }

    private async Task ImportInstance(InputFileChangeEventArgs e)
    {
        Microsoft.AspNetCore.Components.Forms.IBrowserFile file = e.File;
        if (file == null) return;
        
        isImporting = true;
        importProgress = 0;
        dashboardAlert = null;
        StateHasChanged();
        
        try
        {
            string tempZipPath = System.IO.Path.GetTempFileName();
            using (System.IO.FileStream fs = new(tempZipPath, System.IO.FileMode.Create))
            {
                using System.IO.Stream readStream = file.OpenReadStream(10L * 1024 * 1024 * 1024); // 10GB max
                byte[] buffer = new byte[81920];
                int bytesRead;
                long totalRead = 0;
                while ((bytesRead = await readStream.ReadAsync(buffer)) > 0)
                {
                    await fs.WriteAsync(buffer.AsMemory(0, bytesRead));
                    totalRead += bytesRead;
                    importProgress = (int)((totalRead * 100) / file.Size);
                    StateHasChanged();
                }
            }
            
            string tempExtractPath = System.IO.Path.Combine(System.IO.Path.GetTempPath(), $"import_{DateTime.UtcNow.Ticks}");
            System.IO.Directory.CreateDirectory(tempExtractPath);
            System.IO.Compression.ZipFile.ExtractToDirectory(tempZipPath, tempExtractPath, true);
            
            ServerInstance newInstance = new();
            
            string metaPath = System.IO.Path.Combine(tempExtractPath, "server-meta.json");
            if (System.IO.File.Exists(metaPath))
            {
                string metaJson = await System.IO.File.ReadAllTextAsync(metaPath);
                try {
                    ServerInstance? metaInstance = System.Text.Json.JsonSerializer.Deserialize<ServerInstance>(metaJson);
                    if (metaInstance != null) {
                        newInstance.Name = metaInstance.Name + " (Imported)";
                        newInstance.AssignedVersion = metaInstance.AssignedVersion;
                        newInstance.ActiveSaveName = metaInstance.ActiveSaveName;
                    }
                } catch {}
            }
            
            if (string.IsNullOrEmpty(newInstance.Name))
                newInstance.Name = $"Imported Server {DateTime.Now:yyyy-MM-dd}";
                
            int highestPort = await DbContext.ServerInstances.AnyAsync() ? await DbContext.ServerInstances.MaxAsync(x => x.Port) : 34197;
            int highestRcon = await DbContext.ServerInstances.AnyAsync() ? await DbContext.ServerInstances.MaxAsync(x => x.RconPort) : 27015;
            
            newInstance.Port = highestPort + 1;
            newInstance.RconPort = highestRcon + 1;
            newInstance.RconPassword = Guid.NewGuid().ToString("N").Substring(0, 8);
            
            DbContext.ServerInstances.Add(newInstance);
            await DbContext.SaveChangesAsync();
            
            string targetPath = InstanceManager.GetLocalDataPath(newInstance.Id);
            System.IO.Directory.CreateDirectory(targetPath);
            
            foreach (string dirPath in System.IO.Directory.GetDirectories(tempExtractPath, "*", System.IO.SearchOption.AllDirectories))
                System.IO.Directory.CreateDirectory(dirPath.Replace(tempExtractPath, targetPath));
                
            foreach (string newPath in System.IO.Directory.GetFiles(tempExtractPath, "*.*", System.IO.SearchOption.AllDirectories))
            {
                if (System.IO.Path.GetFileName(newPath) == "server-meta.json") continue;
                System.IO.File.Copy(newPath, newPath.Replace(tempExtractPath, targetPath), true);
            }
            
            try { System.IO.Directory.Delete(tempExtractPath, true); } catch {}
            try { System.IO.File.Delete(tempZipPath); } catch {}
            
            Navigation.NavigateTo($"/instance/{newInstance.Id}");
        }
        catch (Exception ex)
        {
            dashboardAlert = $"Failed to import server: {ex.Message}";
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
        timer?.Dispose();
    }
}
