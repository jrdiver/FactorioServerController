@page "/settings"
@using FactorioLibrary.Models
@using FactorioLibrary.Services
@inject GlobalSettingsService SettingsService

<PageTitle>Global Settings</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="/" class="btn btn-glass-secondary mb-3"><i class="bi bi-arrow-left me-2"></i>Back to Dashboard</a>
            <h1 class="display-6 text-accent mb-0">Global Settings</h1>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="glass-card mb-4">
                <h4 class="mb-4"><i class="bi bi-gear-fill me-2"></i>Docker Tags Configuration</h4>
                
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="showAllVersions" @bind="AppSettings.ShowAllVersions" />
                    <label class="form-check-label text-white" for="showAllVersions">
                        <strong>Show all patch versions</strong>
                        <div class="text-muted small">By default, the dropdown only shows the latest 10 patches and the top of each minor line (e.g. 1.1.x, 1.0.x) to reduce clutter. Enable this to show every single patch ever released.</div>
                    </label>
                </div>

                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" id="showLegacyVersions" @bind="AppSettings.ShowLegacyVersions" />
                    <label class="form-check-label text-white" for="showLegacyVersions">
                        <strong>Show legacy versions (pre-1.0)</strong>
                        <div class="text-muted small">Enable this to allow selecting Factorio versions released before 1.0 (e.g., 0.18, 0.17). This requires fetching additional history from Docker Hub.</div>
                    </label>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    @if (ShowSaveSuccess)
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill me-2"></i>Settings saved successfully!</span>
                    }
                    else
                    {
                        <span></span>
                    }
                    <button class="btn btn-glass" @onclick="SaveSettings"><i class="bi bi-save-fill me-2"></i>Save Settings</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private GlobalSettings AppSettings = new();
    private bool ShowSaveSuccess = false;

    protected override void OnInitialized()
    {
        AppSettings = SettingsService.GetSettings();
    }

    private async Task SaveSettings()
    {
        await SettingsService.SaveSettingsAsync(AppSettings);
        
        ShowSaveSuccess = true;
        StateHasChanged();
        
        // Hide success message after 3 seconds
        await Task.Delay(3000);
        ShowSaveSuccess = false;
        StateHasChanged();
    }
}
