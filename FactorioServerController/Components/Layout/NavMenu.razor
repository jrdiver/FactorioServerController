<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center gap-2" href="">
            <i class="bi bi-hdd-network-fill text-accent"></i>
            <span>Factorio Manager</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <i class="bi bi-list fs-1"></i>
        </button>
    </div>
</div>

<div class="nav-scrollable @(collapseNavMenu ? "" : "expanded")" @onclick="ToggleNavMenu">
    <nav class="nav flex-column mt-3">
        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-grid-1x2-fill me-2" aria-hidden="true"></i> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="status">
                <i class="bi bi-activity me-2" aria-hidden="true"></i> Fleet Status
            </NavLink>
        </div>


        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="settings">
                <i class="bi bi-gear-fill me-2" aria-hidden="true"></i> Settings
            </NavLink>
        </div>

        <AuthorizeView Roles="Administrator">
            <Authorized>
                <div class="nav-item px-3 mb-1">
                    <NavLink class="nav-link" href="users">
                        <i class="bi bi-people-fill me-2" aria-hidden="true"></i> Users
                    </NavLink>
                </div>
                <div class="nav-item px-3 mb-1">
                    <NavLink class="nav-link" href="admin/global-mods">
                        <i class="bi bi-box-seam me-2" aria-hidden="true"></i> Global Mods
                    </NavLink>
                </div>
                <div class="nav-item px-3 mb-1">
                    <NavLink class="nav-link" href="admin/modpacks">
                        <i class="bi bi-box2-fill me-2" aria-hidden="true"></i> Modpacks
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-item px-3 mb-1">
            <NavLink class="nav-link" href="help">
                <i class="bi bi-book-half me-2" aria-hidden="true"></i> Help & API
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3 mt-4">
                    <form method="post" action="/api/auth/logout">
                        <AntiforgeryToken />
                        <button type="submit" class="nav-link btn btn-link text-danger text-start w-100" style="border: none;">
                            <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}