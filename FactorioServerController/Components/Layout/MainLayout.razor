@inherits LayoutComponentBase

<div class="d-flex flex-column flex-md-row min-vh-100">
    <div class="sidebar glass-panel m-3 d-flex flex-column" style="width: 250px; min-width: 250px;">
        <NavMenu />
    </div>

    <main class="flex-grow-1 d-flex flex-column p-3 p-md-4 overflow-hidden">
        <div class="d-flex justify-content-end mb-4">
            <a href="https://wiki.factorio.com/" target="_blank" class="text-accent text-decoration-none"><i class="bi bi-question-circle me-1"></i> Factorio Wiki</a>
        </div>

        <article class="content w-100">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
